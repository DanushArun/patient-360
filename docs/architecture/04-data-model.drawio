<mxfile host="app.diagrams.net" modified="2026-09-16T18:00:00.000Z" agent="SAARTHI-CoCo" type="device"><diagram name="Data Model" id="datamodel-1"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="204" parent="1" value="&lt;b&gt;SAARTHI — Data Model&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1"><mxGeometry as="geometry" x="40" y="20" width="500" height="35" /></mxCell><mxCell id="205" parent="1" value="Every table, every key field, every relationship. 18 tables across 4 schemas.&lt;br/&gt;Three timestamp columns (event_time, source_recorded_at, ingested_at) on every evidence-bearing table." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#64748B;" vertex="1"><mxGeometry as="geometry" x="40" y="55" width="900" height="35" /></mxCell><mxCell id="206" parent="1" value="&lt;b&gt;PATIENT&lt;/b&gt;&#10;─────────&#10;patient_id PK&#10;tenant_id&#10;abha_ref (nullable)&#10;name, dob, gender&#10;district, state&#10;primary_language&#10;created_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="40" y="130" width="190" height="170" /></mxCell><mxCell id="207" parent="1" value="&lt;b&gt;ID_MAP&lt;/b&gt;&#10;─────────&#10;map_id PK&#10;patient_id FK → PATIENT&#10;source_system&#10;source_patient_id&#10;link_status:&#10;  abha_linked |&#10;  manually_verified |&#10;  quarantined&#10;link_evidence&#10;linked_at&#10;&#10;&lt;b&gt;Quarantined = contributes&#10;NO evidence to any answer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="260" y="120" width="200" height="200" /></mxCell><mxCell id="208" parent="1" value="&lt;b&gt;CONSENT&lt;/b&gt;&#10;─────────&#10;consent_id PK&#10;patient_id FK&#10;purpose&#10;status: active | expired | revoked&#10;granted_at, expires_at, revoked_at&#10;&#10;&lt;b&gt;Checked at QUERY TIME&lt;/b&gt;&#10;(not just at ingest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="490" y="130" width="200" height="160" /></mxCell><mxCell id="209" parent="1" value="&lt;b&gt;FACILITY_REGISTRY&lt;/b&gt;&#10;─────────&#10;facility_id PK&#10;name, city, state&#10;type: hub | spoke | lab |&#10;  imaging_centre | insurer&#10;abdm_registered (boolean)&#10;contact_info" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="720" y="130" width="200" height="140" /></mxCell><mxCell id="210" parent="1" value="&lt;b&gt;ENCOUNTER&lt;/b&gt;&#10;─────────&#10;encounter_id PK&#10;patient_id FK&#10;facility_id FK&#10;type: opd | daycare | inpatient |&#10;  imaging | lab_visit&#10;scheduled_time&#10;event_time&#10;cycle_number (nullable)&#10;status: scheduled | completed |&#10;  delayed | cancelled&#10;delay_reason (nullable)&#10;gap_type: documentation |&#10;  clinical_complication |&#10;  financial | logistics | none&#10;&#10;&lt;b&gt;scheduled_time ≠ event_time&#10;when a cycle is delayed&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="40" y="370" width="210" height="230" /></mxCell><mxCell id="211" parent="1" value="&lt;b&gt;CLINICAL_EVENT&lt;/b&gt;&#10;─────────&#10;event_id PK&#10;patient_id FK&#10;encounter_id FK&#10;event_type: diagnosis | lab |&#10;  imaging | medication | pathology&#10;code_system (ICD-10/LOINC/SNOMED)&#10;code, display&#10;value_num, value_text, unit&#10;specimen_id (nullable)&#10;accession_id (nullable)&#10;status: ordered | collected |&#10;  resulted | administered |&#10;  dispensed | cancelled&#10;&#10;event_time&#10;source_recorded_at&#10;ingested_at&#10;&#10;&lt;b&gt;3 CLOCKS (R2)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="280" y="360" width="220" height="270" /></mxCell><mxCell id="212" parent="1" value="&lt;b&gt;TREATMENT_PLAN&lt;/b&gt;&#10;─────────&#10;plan_id PK&#10;patient_id FK&#10;version&#10;regimen_name&#10;planned_cycles&#10;current_cycle&#10;modification_reason&#10;tumor_board_date (nullable)&#10;effective_from&#10;supersedes_plan_id FK&#10;&#10;&lt;b&gt;Versioned — Dipali had&#10;4 plan changes in 18 months&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="530" y="370" width="210" height="220" /></mxCell><mxCell id="213" parent="1" value="&lt;b&gt;COVERAGE&lt;/b&gt;&#10;─────────&#10;coverage_id PK&#10;patient_id FK&#10;payer_type: scheme | insurer | self&#10;payer_name&#10;policy_number&#10;effective_from, effective_to&#10;annual_limit&#10;used_amount&#10;&#10;&lt;b&gt;Separate from AUTHORIZATION&lt;/b&gt;&#10;(coverage = &quot;has a policy&quot;,&#10;authorization = &quot;this episode&#10;is pre-approved&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="770" y="370" width="220" height="220" /></mxCell><mxCell id="214" parent="1" value="&lt;b&gt;AUTHORIZATION&lt;/b&gt;&#10;─────────&#10;auth_id PK&#10;coverage_id FK&#10;encounter_id FK&#10;package_code&#10;requested_amount&#10;approved_amount&#10;status: pending | approved |&#10;  denied | partial | expired |&#10;  conflicting&#10;portability: same_state |&#10;  cross_state_approved |&#10;  cross_state_pending |&#10;  cross_state_denied&#10;requested_at, responded_at&#10;valid_until&#10;&#10;&lt;b&gt;When table says 'pending'&#10;but letter says 'approved'&#10;→ status = conflicting&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="1020" y="360" width="220" height="280" /></mxCell><mxCell id="215" parent="1" value="&lt;b&gt;DOCUMENT&lt;/b&gt;&#10;─────────&#10;doc_id PK&#10;patient_id FK (null for reference)&#10;scope: patient | reference&#10;doc_type: pathology | discharge |&#10;  lab_report | imaging | auth_letter |&#10;  consent | referral | prescription |&#10;  pmjay_manual | fda_label | guideline&#10;version&#10;accession_id&#10;file_hash&#10;source_facility FK&#10;ingestion_method:&#10;  digital_emr | physical_folder |&#10;  whatsapp_photo | downloaded_pdf |&#10;  batch_printout&#10;signed_at, effective_at, ingested_at&#10;supersedes_doc_id FK&#10;&#10;&lt;b&gt;scope separates corpora (R6)&lt;/b&gt;&#10;&lt;b&gt;3 clocks (R2)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="40" y="680" width="230" height="330" /></mxCell><mxCell id="216" parent="1" value="&lt;b&gt;DOC_PAGE&lt;/b&gt;&#10;─────────&#10;doc_id FK&#10;page_index&#10;text (markdown)&#10;char_count&#10;&#10;&lt;b&gt;One row per page&lt;/b&gt;&#10;(from AI_PARSE_DOCUMENT&#10;with page_split=TRUE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="300" y="700" width="180" height="130" /></mxCell><mxCell id="217" parent="1" value="&lt;b&gt;ASSERTION&lt;/b&gt;&#10;─────────&#10;assertion_id PK&#10;doc_id FK&#10;page_index&#10;specimen_id (nullable)&#10;subject&#10;predicate&#10;value, unit&#10;negation (boolean)&#10;missingness_state:&#10;  present |&#10;  explicitly_negative |&#10;  pending |&#10;  not_received |&#10;  conflicting |&#10;  unreadable |&#10;  superseded&#10;extractor_version&#10;char_start, char_end&#10;&#10;&lt;b&gt;R3 — missingness is a TYPE&lt;/b&gt;&#10;&lt;b&gt;&quot;not received&quot; ≠ &quot;negative&quot;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="510" y="680" width="220" height="330" /></mxCell><mxCell id="218" parent="1" value="&lt;b&gt;EVIDENCE_LINK&lt;/b&gt;&#10;─────────&#10;link_id PK&#10;assertion_id FK&#10;target_type: assertion |&#10;  clinical_event | document&#10;target_id&#10;relation:&#10;  supports |&#10;  conflicts_with |&#10;  supersedes |&#10;  complemented_by&#10;&#10;&lt;b&gt;The reconciliation graph&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="760" y="700" width="210" height="190" /></mxCell><mxCell id="219" parent="1" value="&lt;b&gt;REVIEW_ISSUE&lt;/b&gt;&#10;─────────&#10;issue_id PK&#10;rule_id, rule_version&#10;patient_id FK&#10;encounter_id FK&#10;gate: clinical | surveillance |&#10;  documentation | coverage | identity&#10;state: open | evidence_received |&#10;  closed | escalated&#10;reason&#10;evidence_ids (ARRAY)&#10;created_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="40" y="1060" width="220" height="200" /></mxCell><mxCell id="220" parent="1" value="&lt;b&gt;TASK&lt;/b&gt;&#10;─────────&#10;task_id PK&#10;issue_id FK (nullable)&#10;type: documentation_review |&#10;  evidence_received |&#10;  consult_request |&#10;  record_request |&#10;  scheme_referral&#10;owner, assigned_to&#10;state: open | in_progress |&#10;  completed | cancelled&#10;decision, reason&#10;target_facility FK (nullable)&#10;target_department (nullable)&#10;scheme_id FK (nullable)&#10;idempotency_key&#10;actor&#10;created_at, resolved_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="290" y="1050" width="230" height="230" /></mxCell><mxCell id="221" parent="1" value="&lt;b&gt;ANSWER_RUN&lt;/b&gt;&#10;─────────&#10;run_id PK&#10;question&#10;role&#10;patient_id FK&#10;known_as_of TIMESTAMP&#10;answer_status:&#10;  supported | partial | insufficient&#10;claims_json (evidence IDs only)&#10;evidence_ids (ARRAY)&#10;tool_calls (ARRAY)&#10;model_version&#10;validation_results JSON&#10;stripped_claims JSON&#10;latency_ms&#10;cost_credits&#10;created_at&#10;&#10;&lt;b&gt;Stores POINTERS not content&lt;/b&gt;&#10;(DPDP erasure compliance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="550" y="1050" width="230" height="270" /></mxCell><mxCell id="222" parent="1" value="&lt;b&gt;SCHEME_REGISTRY&lt;/b&gt;&#10;─────────&#10;scheme_id PK&#10;name&#10;type: govt | state | ngo | pharma&#10;eligibility_criteria JSON&#10;coverage_scope&#10;max_amount&#10;application_process&#10;application_url&#10;states_applicable (ARRAY)&#10;diagnosis_codes (ARRAY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="810" y="1060" width="220" height="180" /></mxCell><mxCell id="223" parent="1" value="&lt;b&gt;SCHEME_ELIGIBILITY&lt;/b&gt;&#10;(Dynamic Table)&#10;─────────&#10;patient_id FK&#10;scheme_id FK&#10;eligible (boolean)&#10;match_reason&#10;checked_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="1060" y="1060" width="200" height="100" /></mxCell><mxCell id="224" parent="1" value="&lt;b&gt;ROLE_PATIENT_MAP&lt;/b&gt;&#10;─────────&#10;user_name&#10;role_type: oncologist |&#10;  coordinator | family |&#10;  cardiologist | admin&#10;patient_ids (ARRAY)&#10;facility_id FK&#10;&#10;&lt;b&gt;Used by Row Access Policy&#10;and Layer 2 of R5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="1060" y="1190" width="200" height="140" /></mxCell><mxCell id="225" parent="1" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#4755