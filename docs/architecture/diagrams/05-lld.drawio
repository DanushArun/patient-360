nt&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;question&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;known_as_of&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;answer_status&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;  supported|partial|insufficient&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;claims  JSON [{text, evidence_ids}]&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;tool_calls  JSON&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;model_version&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;validation_result  JSON&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;latency_ms&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;created_at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1720" y="446" width="400" height="158" as="geometry" /></mxCell><mxCell id="c20" value="&lt;b&gt;ACCESS_LOG&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;log_id  PK&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;tenant_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;actor / role&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;action&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;target_type / target_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;at&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="519" width="400" height="92" as="geometry" /></mxCell><mxCell id="c21" value="B · WHERE EACH FIELD COMES FROM — source to target mapping" style="text;html=1;whiteSpace=wrap;overflow=block;strokeColor=none;fillColor=none;ali