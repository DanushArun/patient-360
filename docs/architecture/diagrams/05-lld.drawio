ll><mxCell id="c28" value="Blood count from the lab system" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="705" width="300" height="54" as="geometry" /></mxCell><mxCell id="c29" value="HL7 v2 ORU^R01  OBX segment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="705" width="300" height="54" as="geometry" /></mxCell><mxCell id="c30" value="CLINICAL_EVENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="705" width="250" height="54" as="geometry" /></mxCell><mxCell id="c31" value="event_type=lab · code=LOINC 6690-2 · value_num=OBX-5 · value_unit=OBX-6 · event_time=OBX-14 · source_recorded_at=MSH-7 · status=administered" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#64748B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="705" width="620" height="54" as="geometry" /></mxCell><mxCell id="c32" value="Unit string normalised to 10^9/L. A result with no unit is stored unreadable, never guessed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#B45309;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1510" y="705" width="610" height="54" as="geometry" /></mxCell><mxCell id="c33" value="Pathology report PDF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="759" width="300" height="54" as="geometry" /></mxCell><mxCell id="c34" value="file on a stage + AI_PARSE_DOCUMENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="759" width="300" height="54" as="geometry" /></mxCell><mxCell id="c35" value="DOCUMENT + DOC_PAGE + ASSERTION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="759" width="250" height="54" as="geometry" /></mxCell><mxCell id="c36" value="doc_type=pathology · accession_id parsed from the header · one DOC_PAGE per page · ASSERTION per finding with char offsets" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#64748B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="759" width="620" height="54" as="geometry" /></mxCell><mxCell id="c37" value="If the report says an addendum follows, an ASSERTION with missingness_state=pending is written." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#B45309;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1510" y="759" width="610" height="54" as="geometry" /></mxCell><mxCell id="c38" value="Final addendum arriving later" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="813" width="300" height="54" as="geometry" /></mxCell><mxCell id="c39" value="same accession, new file" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="813" width="300" height="54" as="geometry" /></mxCell><mxCell id="c40" value="DOCUMENT.supersedes_doc_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="813" width="250" height="54" as="geometry" /></mxCell><mxCell id="c41" value="new version row · old version kept · EVIDENCE_LINK relation=supersedes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#64748B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="813" width="620" height="54" as="geometry" /></mxCell><mxCell id="c42" value="The older statement is marked superseded, never deleted. Historical answers still resolve." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#B45309;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1510" y="813" width="610" height="54" as="geometry" /></mxCell><mxCell id="c43" value="Pre-authorisation from the scheme portal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="867" width="300" height="54" as="geometry" /></mxCell><mxCell id="c44" value="portal export or NHCX message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="867" width="300" height="54" as="geometry" /></mxCell><mxCell id="c45" value="AUTHORIZATION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="867" width="250" height="54" as="geometry" /></mxCell><mxCell id="c46" value="service_code · requested_for_date · status · decided_at · source_system=TMS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#64748B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="867" width="620" height="54" as="geometry" /></mxCell><mxCell id="c47" value="The table's status and an approval letter's text are compared. If they differ, both are kept." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#B45309;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1510" y="867" width="610" height="54" as="geometry" /></mxCell><mxCell id="c48" value="Approval letter PDF from an insurer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="921" width="300" height="54" as="geometry" /></mxCell><mxCell id="c49" value="upload or payer feed" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="921" width="300" height="54" as="geometry" /></mxCell><mxCell id="c50" value="DOCUMENT + ASSERTION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="921" width="250" height="54" as="geometry" /></mxCell><mxCell id="c51" value="ASSERTION subject=authorization predicate=status value_text=approved, linked to AUTHORIZATION row" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#64748B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="921" width="620" height="54" as="geometry" /></mxCell><mxCell id="c52" value="This is the classic conflict: table says pending, letter says approved. Surfaced, not resolved." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#B45309;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1510" y="921" width="610" height="54" as="geometry" /></mxCell><mxCell id="c53" value="Record from the previous hospital" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="975" width="300" height="54" as="geometry" /></mxCell><mxCell id="c54" value="national network, FHIR R4 bundle" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="975" width="300" height="54" as="geometry" /></mxCell><mxCell id="c55" value="ENCOUNTER + CLINICAL_EVENT + DOCUMENT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="975" width="250" height="54" as="geometry" /></mxCell><mxCell id="c56" value="source_system=&lt;that hospital&gt; · ID_MAP row created · CONSENT row must already exist" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#64748B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="975" width="620" height="54" as="geometry" /></mxCell><mxCell id="c57" value="Fetched only under a valid consent slip. No slip, no fetch — and the screen says so." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#B45309;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1510" y="975" width="610" height="54" as="geometry" /></mxCell><mxCell id="c58" value="Photo of a paper report" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1029" width="300" height="54" as="geometry" /></mxCell><mxCell id="c59" value="family upload, JPEG/PDF" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="1029" width="300" height="54" as="geometry" /></mxCell><mxCell id="c60" value="DOCUMENT (scope=patient)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="1029" width="250" height="54" as="geometry" /></mxCell><mxCell id="c61" value="parsed the same way · confidence of parse recorded · patient_id from the uploading session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#64748B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="1029" width="620" height="54" as="geometry" /></mxCell><mxCell id="c62" value="Marked as unverified provenance until a person confirms it belongs to this patient." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#B45309;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1510" y="1029" width="610" height="54" as="geometry" /></mxCell><mxCell id="c63" value="Government / quality / privacy document" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1083" width="300" height="54" as="geometry" /></mxCell><mxCell id="c64" value="public PDF, versioned by effective date" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="340" y="1083" width="300" height="54" as="geometry" /></mxCell><mxCell id="c65" value="DOCUMENT (scope=rulebook, patient_id NULL)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="1083" width="250" height="54" as="geometry" /></mxCell><mxCell id="c66" value="indexed into the rulebook search service only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#64748B;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="890" y="1083" width="620" height="54" as="geometry" /></mxCell><mxCell id="c67" value="Physically separate index. Can never appear in a patient-scoped ranked list." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=9;fontColor=#B45309;align=left;verticalAlign=top;spacingLeft=8;spacingTop=5;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1510" y="1083" width="610" height="54" as="geometry" /></mxCell><mxCell id="c68" value="C · THE MODELS — exact job, settings, and what happens when each fails" style="text;html=1;whiteSpace=wrap;overflow=block;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1163" width="1200" height="20" as="geometry" /></mxCell><mxCell id="c69" value="No model produces a status, a number, or a gate outcome. Those come from SQL rules. Amber lines are the failure behaviour." style="text;html=1;whiteSpace=wrap;overflow=block;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#B45309;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1183" width="1700" height="16" as="geometry" /></mxCell><mxCell id="c70" value="&lt;b&gt;Page parser  —  AI_PARSE_DOCUMENT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;mode = LAYOUT, page_split = TRUE&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;in: staged PDF / image  →  out: text per page, tables as markdown&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;runs once per file at ingestion; result cached by file_hash&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;failure: page marked unreadable, file parked, never silently skipped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F7D4F;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1207" width="500" height="104" as="geometry" /></mxCell><mxCell id="c71" value="&lt;b&gt;Fact extractor  —  Claude · JSON schema mode&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;temperature 0, strict schema, retries 2&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;in: one page of text  →  out: typed ASSERTION rows + char offsets&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;schema forbids free text; every field is enumerated or numeric&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;offsets are re-checked against the page; a non-matching span is rejected&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F7D4F;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="1207" width="500" height="104" as="geometry" /></mxCell><mxCell id="c72" value="&lt;b&gt;Embeddings  —  arctic-embed-l-v2.0&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;1024 dimensions, chunk ≈ 512 tokens with overlap&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;two separate indexes: patient scope and rulebook scope&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;rebuilt on document supersession so stale text stops being retrievable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F7D4F;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="1207" width="500" height="104" as="geometry" /></mxCell><mxCell id="c73" value="&lt;b&gt;Reranker  —  Cortex Search built-in&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;hybrid keyword + vector, then rerank&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;top-k 8 for patient scope, top-k 5 for rulebooks&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;scope filter is applied before the search call, never after&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F7D4F;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1600" y="1207" width="500" height="104" as="geometry" /></mxCell><mxCell id="c74" value="&lt;b&gt;Question classifier  —  small LLM + deterministic rules&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;in: the user's question  →  out: class A (medical judgment) or B (record state)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;rules run first and win; the model only handles the ambiguous remainder&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;class A is refused for every role, including doctors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F7D4F;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1323" width="500" height="104" as="geometry" /></mxCell><mxCell id="c75" value="&lt;b&gt;Tool router  —  Cortex Agent&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;tool list is fixed at six; no dynamic tool registration&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;temperature 0, max 6 tool calls per question&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;has no database credential of its own — every tool is a bounded server function&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F7D4F;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="1323" width="500" height="104" as="geometry" /></mxCell><mxCell id="c76" value="&lt;b&gt;Answer writer  —  Claude via Cortex COMPLETE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;in: retrieved facts + evidence IDs only  →  out: sentences + claim/evidence map&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;system prompt forbids any fact not present in the supplied context&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;the prompt is not the control — the proof checker below is&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F7D4F;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1080" y="1323" width="500" height="104" as="geometry" /></mxCell><mxCell id="c77" value="&lt;b&gt;Proof checker  —  deterministic code · no model&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;for each claim: evidence exists · in scope · version matches · typed check passes&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;number, date, status and unit comparisons done in code&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;a claim that fails is deleted and the deletion is written to ANSWER_RUN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2F7D4F;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1600" y="1323" width="500" height="104" as="geometry" /></mxCell><mxCell id="c78" value="D · TOOL CONTRACTS — the only six ways into the data" style="text;html=1;whiteSpace=wrap;overflow=block;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1455" width="1200" height="20" as="geometry" /></mxCell><mxCell id="c79" value="Scope is bound by the server before any of these run. The model chooses which to call; it cannot change what they are allowed to see." style="text;html=1;whiteSpace=wrap;overflow=block;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#64748B;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1475" width="1700" height="16" as="geometry" /></mxCell><mxCell id="c80" value="&lt;b&gt;get_patient_facts&lt;/b&gt;  &lt;font color=&quot;#2F7D4F&quot;&gt;(patient_id, domain, known_as_of) → rows[]&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;parameterised SQL. Scope injected server-side. Returns only rows with ingested_at ≤ known_as_of.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="1499" width="2040" height="44" as="geometry" /></mxCell><mxCell id="c81" value="&lt;b&gt;get_readiness&lt;/b&gt;  &lt;font color=&quot;#2F7D4F&quot;&gt;(patient_id, encounter_id, known_as_of) → gates[]&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;each gate: {gate, outcome, rule_id, rule_version, inputs[], evidence_ids[]}. outcome ∈ pass | fail | not_evaluated | conflicting.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="1549" width="2040" height="44" as="geometry" /></mxCell><mxCell id="c82" value="&lt;b&gt;search_patient_documents&lt;/b&gt;  &lt;font color=&quot;#2F7D4F&quot;&gt;(patient_id, query, known_as_of) → passages[]&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Cortex Search, patient index. Mandatory filters: tenant, patient, version, as-of. Returns doc_id, page_index, char range, text.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="1599" width="2040" height="44" as="geometry" /></mxCell><mxCell id="c83" value="&lt;b&gt;search_reference_documents&lt;/b&gt;  &lt;font color=&quot;#2F7D4F&quot;&gt;(query, jurisdiction, effective_date) → passages[]&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;rulebook index only. Carries no patient identifier at all, by construction.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="1649" width="2040" height="44" as="geometry" /></mxCell><mxCell id="c84" value="&lt;b&gt;cohort_query&lt;/b&gt;  &lt;font color=&quot;#2F7D4F&quot;&gt;(question) → aggregate + query_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Cortex Analyst over the semantic view. Returns the metric definition, filters and supporting row set, not just a number.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="1699" width="2040" height="44" as="geometry" /></mxCell><mxCell id="c85" value="&lt;b&gt;create_review_task&lt;/b&gt;  &lt;font color=&quot;#2F7D4F&quot;&gt;(issue_id, owner, due_at, idempotency_key) → task_id&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;the only write path. Requires an explicit user action. Re-sending the same idempotency_key returns the existing task rather than creating a second one.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="40" y="1749" width="2040" height="44" as="geometry" /></mxCell><mxCell id="c86" value="E · THE DASHBOARD — every screen, what is on it, and in what order" style="text;html=1;whiteSpace=wrap;overflow=block;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1819" width="1200" height="20" as="geometry" /></mxCell><mxCell id="c87" value="Screen 2's ordering is not a preference: it follows the order clinicians are documented to read a chart in. Amber lines are the safety rules." style="text;html=1;whiteSpace=wrap;overflow=block;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#B45309;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1839" width="1700" height="16" as="geometry" /></mxCell><mxCell id="c88" value="&lt;b&gt;1 · Review queue  —  who needs attention before their visit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;row per upcoming encounter, sorted by days-to-visit then severity&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;columns: patient · visit date · open gates · owner · age of oldest gap&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;each gate chip shows its outcome colour and opens its rule + evidence&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;filter: my patients / unassigned / overdue&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;score is labelled 'documentation &amp; coverage review priority' — never 'risk'&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1863" width="680" height="178" as="geometry" /></mxCell><mxCell id="c89" value="&lt;b&gt;2 · Patient 360  —  the two-minute answer, then the detail&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;TOP — readiness strip: five gates, one line each, no scrolling required&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;then, in the order a doctor actually reads:&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;  pathology &amp; biomarkers (version, superseded badge, page link)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;  imaging &amp; scans (staleness vs protocol)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;  bloods (value, unit, collected-at, source lab)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;  history: encounters, regimen, cycle number&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;right rail: coverage status, approvals, open conflicts&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;a gate with no data renders not_evaluated in neutral grey, never green&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="740" y="1863" width="680" height="178" as="geometry" /></mxCell><mxCell id="c90" value="&lt;b&gt;3 · Ask + evidence  —  one cited answer, proof beside it&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;question box with suggested questions for the current patient&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;answer pane: each sentence carries its evidence chips inline&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;clicking a chip opens the evidence drawer at the exact page, line highlighted&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;header shows answer_status and the as-of time the answer was bound to&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;medical-judgment questions return a refusal card naming the treating team&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1440" y="1863" width="680" height="178" as="geometry" /></mxCell><mxCell id="c91" value="&lt;b&gt;4 · Chase &amp; close  —  the gap becomes work that finishes&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;issue detail: rule, version, why it fired, all supporting evidence&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;assign owner, set due date, add a note&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;when new evidence arrives the issue flips to 'evidence received — review pending'&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;accept / reject with a mandatory reason; both are recorded with actor and time&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;acknowledging never alters a source fact; it records a human decision about it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="2053" width="680" height="178" as="geometry" /></mxCell><mxCell id="c92" value="&lt;b&gt;Family view (role-scoped)  —  read-only, derived, never generative&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;renders only issues a coordinator has already reviewed and released&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;shows a document checklist: what to bring, why, and by when&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;no clinical values, no free-text answers, no evidence drawer&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;asking a medical question returns the same refusal for every role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=9;fontColor=#1F2937;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="740" y="2053" width="680" height="178" as="geometry" /></mxCell><mxCell id="c93" value="&lt;b&gt;Ordering rule for every screen:&lt;/b&gt;  the answer first, the evidence one click away, the raw record two.  Nothing on any screen is generated without a citation that resolves.  &lt;b&gt;Synthetic patient data only — no real medical record is used anywhere in this system.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;fontSize=10;fontColor=#64748B;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="2259" width="2040" height="44" as="geometry" /></mxCell></root></mxGraphModel>