<mxfile host="app.diagrams.net" modified="2026-09-16T18:00:00.000Z" agent="SAARTHI-CoCo" type="device"><diagram name="Data Pipeline" id="pipeline-1"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="201" parent="1" value="&lt;b&gt;SAARTHI&lt;/b&gt; — Data Pipeline Architecture" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1F2937;" vertex="1"><mxGeometry as="geometry" x="500" y="20" width="600" height="40" /></mxCell><mxCell id="202" parent="1" value="Every Snowflake feature is annotated. Task-driven for AI steps, Dynamic Table-driven for deterministic steps." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontColor=#64748B;" vertex="1"><mxGeometry as="geometry" x="400" y="55" width="800" height="25" /></mxCell><mxCell id="203" parent="1" value="&lt;b&gt;LOCAL — Synthetic Data Generation&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1;strokeDasharray=6 3;fontSize=13;fontStyle=1;fontColor=#475569;verticalAlign=top;spacingTop=10;arcSize=4;" vertex="1"><mxGeometry as="geometry" x="20" y="100" width="1560" height="160" /></mxCell><mxCell id="204" parent="1" value="&lt;b&gt;Seeded Fact Ledger&lt;/b&gt;&#10;&lt;font point-size='9'&gt;ledger.py — single source of truth&#10;Deterministic seed=17&#10;All downstream data derived from this&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=11;fontColor=#1F2937;verticalAlign=top;spacingTop=6;dashed=0;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="40" y="130" width="220" height="110" /></mxCell><mxCell id="205" parent="1" value="&lt;b&gt;Source Projections&lt;/b&gt;&#10;&lt;font point-size='9'&gt;Hub MRN, Spoke MRN&#10;PM-JAY ID, Insurer ID&#10;ABHA (if exists)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=11;fontColor=#1F2937;verticalAlign=top;spacingTop=6;dashed=0;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="300" y="130" width="180" height="110" /></mxCell><mxCell id="206" parent="1" value="&lt;b&gt;Document Renderer&lt;/b&gt;&#10;&lt;font point-size='9'&gt;PDFs from same facts&#10;Pathology, discharge, auth letters&#10;With Indian format variants&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=11;fontColor=#1F2937;verticalAlign=top;spacingTop=6;dashed=0;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="520" y="130" width="200" height="110" /></mxCell><mxCell id="207" parent="1" value="&lt;b&gt;Corruption Injector&lt;/b&gt;&#10;&lt;font point-size='9'&gt;12 named scenarios from&#10;Dipali's real reports:&#10;grade discordance, unit mismatch,&#10;late addendum, injection text...&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontSize=11;fontColor=#1F2937;verticalAlign=top;spacingTop=6;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="760" y="130" width="220" height="110" /></mxCell><mxCell id="208" parent="1" value="&lt;b&gt;Eval Generator&lt;/b&gt;&#10;&lt;font point-size='9'&gt;80 questions + truth key&#10;The ledger IS the answer key&#10;Split: 40 dev / 40 held-out&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1;fontSize=11;fontColor=#1F2937;verticalAlign=top;spacingTop=6;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="1020" y="130" width="200" height="110" /></mxCell><mxCell id="209" parent="1" value="&lt;b&gt;Reference Docs&lt;/b&gt;&#10;&lt;font point-size='9'&gt;Real public PDFs:&#10;PM-JAY manual, trastuzumab&#10;label, NCG guidelines,&#10;DPDP Act, NMC guidelines&lt;/font&gt;" style="rounded=1;whiteSpace=wrap