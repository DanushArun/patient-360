# Copy to .env.local and fill in your synthetic-development account.
# Keep false for design work: /design-preview/PAT-DC-07 uses recorded project data.
# Enable only after checking account identity and account-side cost controls.
SAARTHI_SNOWFLAKE_ENABLED=false
SNOWFLAKE_ACCOUNT=KGTPGHJ-YJ28449
SAARTHI_SNOWFLAKE_ALLOWED_ACCOUNT=KGTPGHJ-YJ28449
SNOWFLAKE_USER=your-user
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/your-key.p8
# Hosted deployment: set SNOWFLAKE_PRIVATE_KEY as a server-side secret instead of a file path.
# Never prefix credentials with NEXT_PUBLIC_. Never configure both key sources.
SNOWFLAKE_WAREHOUSE=SAARTHI_AI_WH
# Set to the exact HTTPS origin after hosting is provisioned.
# SAARTHI_ALLOWED_ORIGINS=https://your-project.vercel.app

# Set the exact frozen release commit (40 hex) or source manifest hash (64 hex).
# /api/health returns unavailable until this and restricted Snowflake access are configured.
SAARTHI_RELEASE_REVISION=
