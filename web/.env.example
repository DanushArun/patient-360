# Copy to .env.local and fill in your synthetic-development account.
# Keep false for design work: /design-preview/PAT-DC-07 uses recorded project data.
# Enable only after checking account identity and account-side cost controls.
SAARTHI_SNOWFLAKE_ENABLED=false
# Temporary legacy direct-table compatibility for a single-operator recording.
# Requires development mode; never use on a shared/public server. Start with
# NODE_USE_SYSTEM_CA=1 npm run dev:recording (binds to 127.0.0.1 only).
SAARTHI_LOCAL_RECORDING_ADMIN=false
SNOWFLAKE_ACCOUNT=your-organization-account
SNOWFLAKE_USER=your-user
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/your-key.p8
SNOWFLAKE_WAREHOUSE=SAARTHI_AI_WH
# Optional: set ollama for local inference; otherwise use Snowflake.
SAARTHI_LLM_PROVIDER=snowflake
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=patient360-qwen2.5:3b
