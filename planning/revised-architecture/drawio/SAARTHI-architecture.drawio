        <mxCell id="p6_q" value="&lt;b&gt;Question text&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Data flow]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Free-form natural language&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontColor=#000000;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6_sess" value="&lt;b&gt;Session hardening&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Process]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;USE SECONDARY ROLES NONE&lt;br/&gt;⚠ F7 · without this a secondary ACCOUNTADMIN&lt;br/&gt;satisfies the privilege check&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8b1a1a;strokeColor=#5a0f0f;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="660" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6_cls" value="&lt;b&gt;Class A/B classifier&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Process]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;AI_CLASSIFY&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8a5a00;strokeColor=#5c3c00;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="780" y="300" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6_ag" value="&lt;b&gt;SAARTHI Agent&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Process]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;⚠ A1 · given a raw search tool it derives patient_id from the&lt;br/&gt;question and injects the filter itself. Agent-generated&lt;br/&gt;filters are worthless as a scope control.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8a5a00;strokeColor=#5c3c00;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="1020" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6_scope" value="&lt;b&gt;Selection + authorisation&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Process]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;SELECTION: PATIENT_BINDING for CURRENT_SESSION()&lt;br/&gt;set by a human click, never by question text&lt;br/&gt;AUTHORISATION: CURRENT_USER → PRACTITIONER → CARE_TEAM&lt;br/&gt;⚠ F3 · CURRENT_USER survives owner's-rights elevation&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8b1a1a;strokeColor=#5a0f0f;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6_cons" value="&lt;b&gt;Consent check&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Process]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Evaluated at query time, not at ingest.&lt;br/&gt;The binding is a record of selection,&lt;br/&gt;NEVER a cached authorisation.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8b1a1a;strokeColor=#5a0f0f;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="780" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6_inj" value="&lt;b&gt;Server-side filter injection&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Process]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;@eq patient filter · ⚠ F6&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8b1a1a;strokeColor=#5a0f0f;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="780" y="780" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p6_idx" value="&lt;b&gt;DOC_CHUNK index&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Data store]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;NO row access policy&lt;br/&gt;⚠ F5 · Cortex Search runs with owner's rights and IGNORES&lt;br/&gt;row access policies. ⚠ F4 · a service cannot be created over&lt;br/&gt;a RAP-protected table. So this store returns IDs, never content.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#123a5c;strokeColor=#0b2439;fontColor=#ffffff;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="1020" width="660" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p6_page" value="&lt;b&gt;DOC_PAGE content&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Data store]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;ROW ACCESS POLICY on CURRENT_USER.&lt;br/&gt;The only place governed&lt;br/&gt;content lives.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#123a5c;strokeColor=#0b2439;fontColor=#ffffff;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
