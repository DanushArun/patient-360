          <mxGeometry x="60" y="300" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3_cls" value="&lt;b&gt;Class A/B Classifier&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: AI_CLASSIFY]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Routes clinical-judgment questions to&lt;br/&gt;refusal before any retrieval happens.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8a5a00;strokeColor=#5c3c00;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="300" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3_agent" value="&lt;b&gt;SAARTHI Agent&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: Cortex Agent → claude-opus-4-8]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Plans tool calls, ranks passages, phrases answers.&lt;br/&gt;8 generic tools, 4 skills. Cannot see patient_id.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8a5a00;strokeColor=#5c3c00;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="780" y="300" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3_valid" value="&lt;b&gt;Answer Validator&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: SQL procedure with AI_FILTER]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;6 checks. Strips any claim not supported&lt;br/&gt;by cited evidence. Fails closed.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8b1a1a;strokeColor=#5a0f0f;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="1140" y="300" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3_engine" value="&lt;b&gt;Evidence and Readiness Engine&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: SQL procedures + Dynamic Tables]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;16 versioned rules over 5 gates. Decides&lt;br/&gt;every status, number and comparison.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#123a5c;strokeColor=#0b2439;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3_tools" value="&lt;b&gt;Tool Layer&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: 11 SQL procedures, EXECUTE AS OWNER]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Derives scope from CURRENT_USER. Checks consent at query time.&lt;br/&gt;Returns facts, never conclusions.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8b1a1a;strokeColor=#5a0f0f;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="540" width="660" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3_core" value="&lt;b&gt;Governed Clinical Store&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: tables + row access policy]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;25 tables. Identity, consent, binding, clinical&lt;br/&gt;events, coverage, documents, assertions.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1c4568;fontColor=#ffffff;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3_pidx" value="&lt;b&gt;Patient Document Index&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: Cortex Search service]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Chunks of patient documents.&lt;br/&gt;Returns IDs only, never content.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1c4568;fontColor=#ffffff;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="780" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3_ridx" value="&lt;b&gt;Reference Document Index&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: Cortex Search service]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Chunks of regulatory text. Physically&lt;br/&gt;separate service. No patient data.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1c4568;fontColor=#ffffff;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="780" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3_sem" value="&lt;b&gt;Semantic View&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: Cortex Analyst + 6 VQRs]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Cohort questions in&lt;br/&gt;natural language.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1c4568;fontColor=#ffffff;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1140" y="780" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p3_audit" value="&lt;b&gt;Audit Store&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: ANSWER_RUN table]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Evidence pointers, consent id,&lt;br/&gt;rule versions. Never answer text.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1c4568;fontColor=#ffffff;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="1020" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3_extract" value="&lt;b&gt;Extraction Pipeline&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: Tasks with AI_PARSE_DOCUMENT + AI_COMPLETE]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Parses documents, extracts typed assertions&lt;br/&gt;under R7 two-pass verification.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8a5a00;strokeColor=#5c3c00;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="780" y="1020" width="660" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3_srcsys" value="&lt;b&gt;Clinical source systems&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;HIS, LIS, PACS&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#6c6c6c;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1020" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3_mcp" value="&lt;b&gt;MCP Server&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;2 read-only tools&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#6c6c6c;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="1500" y="300" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p3_ticket" value="&lt;b&gt;Ticketing system&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[External System]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Review tasks&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8c8c8c;strokeColor=#6c6c6c;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="1500" y="540" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="e3_1" value="asks a question&lt;br/&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_user" target="p3_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_2" value="classifies intent&lt;br/&gt;before retrieval [SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_app" target="p3_cls">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_3" value="forwards Class B&lt;br/&gt;questions only [SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_cls" target="p3_agent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_4" value="calls tools · no patient_id&lt;br/&gt;in any schema [SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_agent" target="p3_tools">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_5" value="submits draft answer&lt;br/&gt;with evidence ids [SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_agent" target="p3_valid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_6" value="returns validated answer&lt;br/&gt;or strips the claim [SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_valid" target="p3_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_7" value="reads scoped rows&lt;br/&gt;[SQL, under RAP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_tools" target="p3_core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_8" value="requests gate outcomes&lt;br/&gt;as of a timestamp [SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_tools" target="p3_engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_9" value="searches with server-injected&lt;br/&gt;filter [Cortex Search]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_tools" target="p3_pidx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_10" value="searches reference text&lt;br/&gt;by jurisdiction" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_tools" target="p3_ridx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_11" value="answers cohort&lt;br/&gt;questions [Analyst]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_tools" target="p3_sem">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_12" value="logs evidence pointers&lt;br/&gt;and consent id [SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_app" target="p3_audit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_13" value="delivers documents and bundles&lt;br/&gt;[Stage, CSV, FHIR R4]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_srcsys" target="p3_extract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_14" value="writes verified&lt;br/&gt;assertions [SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_extract" target="p3_core">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_15" value="feeds chunks&lt;br/&gt;[Dynamic Table]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_extract" target="p3_pidx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_16" value="invokes read-only tools&lt;br/&gt;[MCP over HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_mcp" target="p3_tools">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3_17" value="creates review task&lt;br/&gt;[MCP]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p3_tools" target="p3_ticket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page4" name="4. Components - Readiness Engine (C4 L3)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1028" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4_cb" value="Container boundary · Evidence and Readiness Engine" style="rounded=1;arcSize=3;html=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;fontColor=#333333;verticalAlign=top;align=left;spacingLeft=14;spacingTop=2;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="32" y="242" width="1076" height="726" as="geometry" />
        </mxCell>
        <mxCell id="p4_tools" value="&lt;b&gt;Tool Layer&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: SQL procedures]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Calls the engine with a patient, an encounter&lt;br/&gt;and a known_as_of timestamp&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8b1a1a;strokeColor=#5a0f0f;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_gates" value="&lt;b&gt;evaluate_gates&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Component: SQL procedure, EXECUTE AS OWNER]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Single source of truth for readiness. Takes known_as_of as a&lt;br/&gt;parameter — which is why it cannot be a Dynamic Table.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#123a5c;strokeColor=#0b2439;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="300" width="660" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_prec" value="&lt;b&gt;Rule Precedence Resolver&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Component: SQL over RULE.specificity]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;The most specific matching rule suppresses more&lt;br/&gt;general ones for the same gate and concept.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#123a5c;strokeColor=#0b2439;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_harm" value="&lt;b&gt;DT_HARMONIZED_EVENTS&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Component: Dynamic Table]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Normalises units with plausibility rejection. Computes ANC&lt;br/&gt;from a differential and Cockcroft-Gault CrCl.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#123a5c;strokeColor=#0b2439;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="540" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_recon" value="&lt;b&gt;Evidence Reconciler&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Component: SQL procedure]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Detects supersession, cross-source conflict&lt;br/&gt;and discordance across specimens.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#123a5c;strokeColor=#0b2439;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="780" y="540" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_rules" value="&lt;b&gt;RULE catalog&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Component: Snowflake table, versioned]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;16 rules over 6 specialties. Threshold, severity,&lt;br/&gt;guideline reference and provenance per rule.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#123a5c;strokeColor=#0b2439;fontColor=#ffffff;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4_bring" value="&lt;b&gt;Bring-List Deriver&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Component: SQL over REFERRAL + outcomes]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Turns every fail and not_evaluated into&lt;br/&gt;a concrete action for a named person.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#123a5c;strokeColor=#0b2439;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="420" y="780" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4_state" value="&lt;b&gt;READINESS_STATE&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Component: Snowflake table]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Materialised gate outcomes with the&lt;br/&gt;rule version that produced each one.&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=14;whiteSpace=wrap;html=1;fillColor=#123a5c;strokeColor=#0b2439;fontColor=#ffffff;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="780" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="p4_refresh" value="&lt;b&gt;TASK_REFRESH_READINESS&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;[Container: Snowflake Task]&lt;/font&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Materialises the procedure&lt;br/&gt;on a 5-minute schedule&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1c4568;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;" vertex="1" parent="1">
          <mxGeometry x="1140" y="300" width="300" height="150" as="geometry" />
        </mxCell>
