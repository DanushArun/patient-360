  <diagram id="page12" name="12. State - Assertion Verification Lifecycle">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p12_start" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="550" y="170" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p12_extracted" value="&lt;b&gt;Extracted&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Pass A complete&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1c4568;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="420" y="300" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_single" value="&lt;b&gt;SinglePass&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;concept not safety-critical&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1c4568;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_await" value="&lt;b&gt;AwaitingVerification&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;concept is safety-critical&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1c4568;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="780" y="540" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_verified" value="&lt;b&gt;Verified&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Pass B agrees&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#123a5c;strokeColor=#0b2439;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="780" y="780" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_conflict" value="&lt;b&gt;Conflicting&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Pass B disagrees&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8b1a1a;strokeColor=#5a0f0f;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="1140" y="780" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_unver" value="&lt;b&gt;Unverified&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;Pass B errored or timed out&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8b1a1a;strokeColor=#5a0f0f;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="1500" y="780" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_asserted" value="&lt;b&gt;Asserted&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;normalised via ontology&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#123a5c;strokeColor=#0b2439;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="420" y="1020" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_review" value="&lt;b&gt;HumanReview&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;gate returns not_evaluated&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1c4568;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1020" width="660" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_comple" value="&lt;b&gt;Complemented&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;an appended document adds detail&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1c4568;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="60" y="1260" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_superseded" value="&lt;b&gt;Superseded&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;a corrected document arrives&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2e6da4;strokeColor=#1c4568;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="420" y="1260" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_discard" value="&lt;b&gt;Discarded&lt;/b&gt;&lt;br/&gt;&lt;font style='font-size:10px'&gt;clinician rejects both reads&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#8b1a1a;strokeColor=#5a0f0f;fontColor=#ffffff;align=center;verticalAlign=middle;fontSize=12;spacingTop=2;spacingBottom=2;arcSize=40;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1260" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p12_end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="550" y="1500" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p12_note1" value="The transition that does NOT exist is the important one.&lt;br/&gt;&lt;br/&gt;There is no edge from Conflicting or Unverified to&lt;br/&gt;Asserted. A value cannot reach the asserted state&lt;br/&gt;without cross-family agreement or explicit human&lt;br/&gt;confirmation. R7 is enforced by the ABSENCE of a&lt;br/&gt;transition, which is stronger than a validation rule&lt;br/&gt;someone could bypass." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff8dc;strokeColor=#c8a800;fontColor=#000000;align=left;verticalAlign=top;fontSize=10;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1260" width="300" height="230" as="geometry" />
        </mxCell>
        <mxCell id="e12_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p12_start" target="p12_extracted">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12_2" value="not safety-critical" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p12_extracted" target="p12_single">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12_3" value="safety-critical" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p12_extracted" target="p12_await">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12_4" value="Pass B agrees" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="p12_await" target="p12_verified">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12_5" value="Pass B disagrees" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;dashPattern=5 5;strokeColor=#8b1a1a;fontColor=#8b1a1a;" edge="1" parent="1" source="p12_await" target="p12_conflict">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12_6" value="Pass B errored" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jumpStyle=arc;jumpSize=8;strokeColor=#333333;fontSize=10;fontColor=#333333;labelBackgroundColor=#ffffff;endArrow=blockThin;endFill=1;dashed=1;dashPattern=5 5;strokeColor=#8b1a1a;fontColor=#8b1a1a;" edge="1" parent="1" source="p12_await" target="p12_unver">
