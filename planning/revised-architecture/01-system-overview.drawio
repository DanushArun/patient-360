<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-16T18:00:00.000Z" agent="SAARTHI-CoCo" type="device"><diagram name="System Overview" id="overview-1"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="101" parent="1" value="&lt;b&gt;SAARTHI — System Overview&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1"><mxGeometry as="geometry" x="40" y="20" width="600" height="35" /></mxCell><mxCell id="102" parent="1" value="A care readiness copilot that answers one question with cited evidence:&lt;br/&gt;&lt;b&gt;&quot;Is this patient ready for the next step of care — and exactly what is missing?&quot;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;It does NOT make clinical decisions. It does NOT predict outcomes. It shows what the record says,&lt;br/&gt;what's missing, what disagrees, and what the relevant policy requires — with a clickable source for every claim." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#64748B;" vertex="1"><mxGeometry as="geometry" x="40" y="55" width="900" height="85" /></mxCell><mxCell id="103" parent="1" value="&lt;b&gt;WHO USES IT&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;fontColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="40" y="170" width="300" height="25" /></mxCell><mxCell id="104" parent="1" value="&lt;b&gt;👩‍⚕️ ONCOLOGIST&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Uses it for 2 minutes before each patient consultation.&lt;br/&gt;Needs to know: is the tissue diagnosis final? Are labs safe?&lt;br/&gt;Is the echo current? Is authorization in place?&lt;br/&gt;&lt;br/&gt;&lt;b&gt;The system answers all 6 questions in one glance&lt;/b&gt;&lt;br/&gt;(the gate strip on the Patient 360 screen).&lt;br/&gt;&lt;br/&gt;If the oncologist asks a treatment question&lt;br/&gt;(&quot;should I change the regimen?&quot;), the system REFUSES&lt;br/&gt;and routes to the treating team — because only a&lt;br/&gt;Registered Medical Practitioner may decide that&lt;br/&gt;(NMC Telemedicine Guidelines 2020)." style="shape=mxgraph.basic.rect;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=8;spacingLeft=8;align=left;" vertex="1"><mxGeometry as="geometry" x="40" y="210" width="350" height="260" /></mxCell><mxCell id="105" parent="1" value="&lt;b&gt;📋 CARE COORDINATOR&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Uses it between chemotherapy cycles (the 14-21 day gap).&lt;br/&gt;This is Stage 9 — the stage that usually has NO human assigned.&lt;br/&gt;&lt;br/&gt;The coordinator's job: before the patient travels for&lt;br/&gt;the next cycle, check that everything is ready.&lt;br/&gt;Missing pathology addendum? Chase it.&lt;br/&gt;Authorization expired? Renew it.&lt;br/&gt;Labs not drawn? Remind the family.&lt;br/&gt;&lt;br/&gt;Today this happens by memory and phone calls.&lt;br/&gt;&lt;b&gt;SAARTHI makes it tracked and auditable.&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Can also request a specialist consult (e.g., cardiology&lt;br/&gt;for LVEF decline) — creates a tracked task, not a phone call." style="shape=mxgraph.basic.rect;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=8;spacingLeft=8;align=left;" vertex="1"><mxGeometry as="geometry" x="40" y="500" width="350" height="300" /></mxCell><mxCell id="106" parent="1" value="&lt;b&gt;👨‍👩‍👧 PATIENT'S FAMILY&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;The caretaker — usually husband, wife, or adult child —&lt;br/&gt;who physically carries the records folder 500-1,400 km&lt;br/&gt;to the hospital in another city.&lt;br/&gt;&lt;br/&gt;When this person can't travel, the cycle is missed.&lt;br/&gt;(52.5% of missed cycles are because the caretaker&lt;br/&gt;was unavailable — not money, not distance.)&lt;br/&gt;&lt;br/&gt;SAARTHI gives them a &lt;b&gt;bring-list&lt;/b&gt;: a plain-language&lt;br/&gt;checklist of what to carry, translated to Hindi/Tamil/&lt;br/&gt;Bengali/Marathi. This is the #1 output for 85% of users.&lt;br/&gt;&lt;br/&gt;If PM-JAY coverage is exhausted, the bring-list also&lt;br/&gt;shows government schemes and NGOs they might be eligible for.&lt;br/&gt;&lt;br/&gt;The family view NEVER shows raw clinical data.&lt;br/&gt;It NEVER gives medical advice.&lt;br/&gt;Every page says: &lt;b&gt;&quot;Your treating team decides.&quot;&lt;/b&gt;" style="shape=mxgraph.basic.rect;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;rounded=1;arcSize=15;whiteSpace=wrap;html=1;fontSize=11;fontColor=#1E293B;verticalAlign=top;spacingTop=8;spacingLeft=8;align=left;" vertex="1"><mxGeometry as="geometry" x="40" y="830" width="350" height="340" /></mxCell><mxCell id="107" parent="1" value="&lt;b&gt;THE PROBLEM THIS SOLVES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;fontColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="440" y="170" width="400" height="25" /></mxCell><mxCell id="108" parent="1" value="&lt;b&gt;The record doesn't travel.&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;In Indian oncology, 74% of breast cancer patients visit ≥2 hospitals.&lt;br/&gt;Each hospital has its own system, its own patient ID, its own format.&lt;br/&gt;&lt;br/&gt;A patient simultaneously holds:&lt;br/&gt;• A hub hospital MRN (e.g., Tata Main Hospital: MR/24/010770)&lt;br/&gt;• A spoke hospital MRN (e.g., CMC Vellore: AG62251)&lt;br/&gt;• A PM-JAY beneficiary ID&lt;br/&gt;• An insurer member ID&lt;br/&gt;• An Aadhaar number&lt;br/&gt;• Maybe an ABHA (national health ID) — but usually not&lt;br/&gt;&lt;br/&gt;&lt;b&gt;From a real patient's reports (studied for this project):&lt;/b&gt;&lt;br/&gt;3 hospitals, 7 different identifiers, 0 ABHA.&lt;br/&gt;&lt;br/&gt;Her pathology grade was II at the first hospital and III at the&lt;br/&gt;second — because the surgical specimen showed higher-grade tissue&lt;br/&gt;than the biopsy. Both are correct, but the system must show BOTH&lt;br/&gt;and explain WHY they differ, not silently pick one.&lt;br/&gt;&lt;br/&gt;Her HER2 status was 1+ (negative) at one lab and 2+ (equivocal)&lt;br/&gt;at another. If only the first result was seen, she would NOT have&lt;br/&gt;gotten the FISH test that determined her final HER2 status.&lt;br/&gt;That's the difference between the right treatment and the wrong one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="440" y="210" width="430" height="440" /></mxCell><mxCell id="109" parent="1" value="&lt;b&gt;THE NUMBERS&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;14%&lt;/b&gt; of chemo cycles are missed (median delay: 13.75 days)&lt;br/&gt;• &lt;b&gt;52.5%&lt;/b&gt; of missed cycles: caretaker couldn't travel&lt;br/&gt;• &lt;b&gt;84.2%&lt;/b&gt; of breast cancer patients face catastrophic expenditure&lt;br/&gt;• &lt;b&gt;52.8%&lt;/b&gt; resort to distress financing (selling assets/borrowing)&lt;br/&gt;• &lt;b&gt;82.6%&lt;/b&gt; experience a delay somewhere in the treatment pathway&lt;br/&gt;• &lt;b&gt;₹30,000 crore&lt;/b&gt; in insurance claims denied per year&lt;br/&gt;• &lt;b&gt;60-70%&lt;/b&gt; of those denials were preventable before admission&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Sources: Cancer Reports 2020, PMC11265332, PMC12374521,&lt;br/&gt;IRDAI Annual Report 2024-25, IIPS-TMC study&lt;/i&gt;" style="shape=mxgraph.basic.rounded_frame;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontSize=9;fontColor=#7F1D1D;align=left;spacingLeft=6;spacingTop=4;" vertex="1"><mxGeometry as="geometry" x="440" y="680" width="430" height="220" /></mxCell><mxCell id="110" parent="1" value="&lt;b&gt;WHAT THE SYSTEM DOES&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;fontColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="920" y="170" width="400" height="25" /></mxCell><mxCell id="111" parent="1" value="&lt;b&gt;5 READINESS GATES&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;For every patient, before every cycle, the system checks:&lt;br/&gt;&lt;br/&gt;&lt;b&gt;1. CLINICAL GATE&lt;/b&gt;&lt;br/&gt;Are labs safe to treat? (ANC ≥1500, Platelets ≥100K,&lt;br/&gt;adequate renal/hepatic function — thresholds from&lt;br/&gt;NCCN/NCG guidelines, versioned and cited)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;2. SURVEILLANCE GATE&lt;/b&gt;&lt;br/&gt;Is cardiac monitoring current? (LVEF within 90 days&lt;br/&gt;for trastuzumab — FDA label + ESC 2022 guidelines)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;3. DOCUMENTATION GATE&lt;/b&gt;&lt;br/&gt;Is the pathology report final? Is the addendum here?&lt;br/&gt;Is there a superseded version that should be replaced?&lt;br/&gt;&lt;br/&gt;&lt;b&gt;4. COVERAGE GATE&lt;/b&gt;&lt;br/&gt;Is authorization approved? Does the approved amount&lt;br/&gt;cover the treatment? Is the PM-JAY ceiling exhausted?&lt;br/&gt;If coverage fails: &lt;b&gt;show eligible government schemes.&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;5. IDENTITY GATE&lt;/b&gt;&lt;br/&gt;Do all records resolve to the same patient?&lt;br/&gt;If two facilities have conflicting demographics,&lt;br/&gt;the conflict is flagged — never silently merged.&lt;br/&gt;&lt;br/&gt;Each gate shows: rule ID, rule version, the exact&lt;br/&gt;data that triggered it, and a click-through to the&lt;br/&gt;source document or database row." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=8;shadow=1;" vertex="1"><mxGeometry as="geometry" x="920" y="210" width="420" height="540" /></mxCell><mxCell id="112" parent="1" value="&lt;b&gt;WHAT IT DOES NOT DO&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Does NOT recommend treatment (Class A — refused for ALL roles)&lt;br/&gt;• Does NOT predict survival or deterioration&lt;br/&gt;• Does NOT produce a &quot;risk score&quot; — it shows open gate failures&lt;br/&gt;• Does NOT replace the doctor's judgment&lt;br/&gt;• Does NOT display a confidence percentage — ever&lt;br/&gt;• Does NOT process real patient data (synthetic only for hackathon)&lt;br/&gt;&lt;br/&gt;Every output ends with: &lt;b&gt;&quot;Treatment readiness cannot be determined&lt;br/&gt;from these records alone. The treating team decides.&quot;&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;i&gt;This is not a disclaimer — it is a legal requirement&lt;br/&gt;(NMC Act 2019, CDSCO Medical Devices Rules 2017)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="920" y="780" width="420" height="220" /></mxCell><mxCell id="113" parent="1" value="&lt;b&gt;VISUAL LEGEND&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;fontColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="40" y="1200" width="300" height="25" /></mxCell><mxCell id="114" parent="1" value="Blue border = AI/Cortex component" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="40" y="1235" width="200" height="25" /></mxCell><mxCell id="115" parent="1" value="Green border = Dynamic Table (auto-refresh)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="260" y="1235" width="230" height="25" /></mxCell><mxCell id="116" parent="1" value="Purple border = Task/Procedure (triggered)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="510" y="1235" width="230" height="25" /></mxCell><mxCell id="117" parent="1" value="Amber border = Guard/Validator (can refuse)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="760" y="1235" width="230" height="25" /></mxCell><mxCell id="118" parent="1" value="Red border = Refusal/Stop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="1010" y="1235" width="180" height="25" /></mxCell><mxCell id="119" parent="1" value="Grey border = Data store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="1210" y="1235" width="160" height="25" /></mxCell></root></mxGraphModel></diagram></mxfile>