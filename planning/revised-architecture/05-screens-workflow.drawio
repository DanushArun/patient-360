<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-16T18:00:00.000Z" agent="SAARTHI-CoCo" type="device"><diagram name="Screens &amp; Clinical Workflow" id="screens-1"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="237" parent="1" value="&lt;b&gt;SAARTHI — User Screens &amp;amp; Clinical Workflow&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1"><mxGeometry as="geometry" x="40" y="20" width="800" height="35" /></mxCell><mxCell id="238" parent="1" value="How the system maps to the 9-stage chemotherapy cycle. Each screen is designed for a specific moment&lt;br/&gt;in the workflow and a specific user — not as a generic dashboard." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#64748B;" vertex="1"><mxGeometry as="geometry" x="40" y="55" width="1000" height="30" /></mxCell><mxCell id="239" parent="1" value="&lt;b&gt;THE 21-DAY CHEMOTHERAPY CYCLE&lt;/b&gt; — 9 stages, repeated every cycle for 6-18 months of treatment" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;fontColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="40" y="110" width="1200" height="25" /></mxCell><mxCell id="240" parent="1" value="&lt;b&gt;Stage 1&lt;/b&gt;&#10;Pre-visit&#10;(travel)&#10;&#10;&lt;font point-size='8' color='#64748B'&gt;Family prepares.&#10;500-1,400 km.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;fontSize=9;fontColor=#1E293B;verticalAlign=top;spacingTop=4;align=center;arcSize=8;" vertex="1"><mxGeometry as="geometry" x="130" y="150" width="120" height="90" /></mxCell><mxCell id="241" parent="1" value="&lt;b&gt;Stage 2&lt;/b&gt;&#10;Registration&#10;+ vitals&#10;&#10;&lt;font point-size='8' color='#64748B'&gt;Identity verified.&#10;New MRN assigned.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;fontSize=9;fontColor=#1E293B;verticalAlign=top;spacingTop=4;align=center;arcSize=8;" vertex="1"><mxGeometry as="geometry" x="270" y="150" width="120" height="90" /></mxCell><mxCell id="242" parent="1" value="&lt;b&gt;Stage 3&lt;/b&gt;&#10;Pre-consult&#10;chart review&#10;&#10;&lt;font point-size='8' color='#64748B'&gt;Oncologist reviews.&#10;2-5 minutes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=9;fontColor=#1E293B;verticalAlign=top;spacingTop=4;align=center;arcSize=8;" vertex="1"><mxGeometry as="geometry" x="410" y="150" width="120" height="90" /></mxCell><mxCell id="243" parent="1" value="&lt;b&gt;Stage 4&lt;/b&gt;&#10;Consultation&#10;&#10;&lt;font point-size='8' color='#64748B'&gt;History, exam,&#10;decision.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1;fontSize=9;fontColor=#1E293B;verticalAlign=top;spacingTop=4;align=center;arcSize=8;" vertex="1"><mxGeometry as="geometry" x="550" y="150" width="120" height="90" /></mxCell><mxCell id="244" parent="1" value="&lt;b&gt;Stage 5&lt;/b&gt;&#10;Gate check&#10;&#10;&lt;font point-size='8' color='#64748B'&gt;Day-of labs vs&#10;protocol.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=9;fontColor=#1E293B;verticalAlign=top;spacingTop=4;align=center;arcSize=8;" vertex="1"><mxGeometry as="geometry" x="690" y="150" width="120" height="90" /></mxCell><mxCell id="245" parent="1" value="&lt;b&gt;Stage 6&lt;/b&gt;&#10;Day-care&#10;admission&#10;&#10;&lt;font point-size='8' color='#64748B'&gt;Bed/chair allotted.&#10;Pre-medication.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;fontSize=9;fontColor=#1E293B;verticalAlign=top;spacingTop=4;align=center;arcSize=8;" vertex="1"><mxGeometry as="geometry" x="830" y="150" width="120" height="90" /></mxCell><mxCell id="246" parent="1" value="&lt;b&gt;Stage 7&lt;/b&gt;&#10;Chemo&#10;administration&#10;&#10;&lt;font point-size='8' color='#64748B'&gt;Drug prepared,&#10;infused.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;fontSize=9;fontColor=#1E293B;verticalAlign=top;spacingTop=4;align=center;arcSize=8;" vertex="1"><mxGeometry as="geometry" x="970" y="150" width="120" height="90" /></mxCell><mxCell id="247" parent="1" value="&lt;b&gt;Stage 8&lt;/b&gt;&#10;Discharge&#10;&#10;&lt;font point-size='8' color='#64748B'&gt;Next cycle date.&#10;Instructions.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1;fontSize=9;fontColor=#1E293B;verticalAlign=top;spacingTop=4;align=center;arcSize=8;" vertex="1"><mxGeometry as="geometry" x="1110" y="150" width="120" height="90" /></mxCell><mxCell id="248" parent="1" value="&lt;b&gt;Stage 9&lt;/b&gt;&#10;Between-&#10;cycle&#10;&#10;&lt;font point-size='8' color='#64748B'&gt;THE GAP.&#10;14-21 days.&#10;No one assigned.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#92400E;strokeWidth=2;fontSize=9;fontColor=#1E293B;verticalAlign=top;spacingTop=4;align=center;arcSize=8;" vertex="1"><mxGeometry as="geometry" x="1250" y="150" width="120" height="90" /></mxCell><mxCell id="249" parent="1" value="&lt;b&gt;OUR SYSTEM LIVES HERE&lt;/b&gt;&#10;(the stage no one is assigned to)" style="shape=mxgraph.basic.rounded_frame;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontSize=9;fontColor=#7F1D1D;align=left;spacingLeft=6;spacingTop=4;" vertex="1"><mxGeometry as="geometry" x="1220" y="250" width="200" height="35" /></mxCell><mxCell id="250" parent="1" value="&lt;b&gt;Class A — system defers&lt;/b&gt;&#10;(only RMP decides)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#64748B;fontStyle=2;" vertex="1"><mxGeometry as="geometry" x="530" y="250" width="150" height="25" /></mxCell><mxCell id="251" parent="1" value="&lt;b&gt;Primary screens for this stage&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#64748B;fontStyle=2;" vertex="1"><mxGeometry as="geometry" x="380" y="250" width="160" height="25" /></mxCell><mxCell id="252" parent="1" value="&lt;b&gt;6 SCREENS — each designed for a specific user at a specific moment&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;fontColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="40" y="310" width="900" height="25" /></mxCell><mxCell id="253" parent="1" value="&lt;b&gt;SCREEN 1: REVIEW QUEUE&lt;/b&gt;&#10;&lt;b&gt;For: Coordinator · Stage: 9 (between-cycle)&lt;/b&gt;&#10;─────────────────────────────────────&#10;&#10;&lt;b&gt;What it shows:&lt;/b&gt;&#10;A prioritized list of all patients with OPEN issues:&#10;• Missing pathology addendum → documentation gate FAIL&#10;• Authorization expired → coverage gate FAIL&#10;• Echo &gt; 90 days old → surveillance gate FAIL&#10;• Labs not drawn 2 days before cycle → clinical gate PENDING&#10;&#10;Sorted by: days until next cycle (most urgent first)&#10;Each row shows: patient name, next cycle date, open gates,&#10;assigned coordinator, last action taken&#10;&#10;&lt;b&gt;Actions available:&lt;/b&gt;&#10;• Click patient → opens Patient 360 (Screen 2)&#10;• &quot;Request Record&quot; → creates tracked task to source facility&#10;• &quot;Request Consult&quot; → creates tracked task to specialist dept&#10;• &quot;Mark Resolved&quot; → with evidence + reason (auditable)&#10;&#10;&lt;b&gt;What it prevents:&lt;/b&gt;&#10;• Missing reports discovered AT the hospital (too late)&#10;• Authorization gaps discovered AT the front desk (too late)&#10;• The 14% of cycles missed because no one was tracking&#10;&#10;&lt;b&gt;Labelling:&lt;/b&gt; &quot;Documentation &amp;amp; Coverage Review Priority&quot;&#10;NEVER &quot;Patient Risk&quot; (it doesn't model clinical deterioration)&#10;&#10;📄 lived-experience-clinicians.md: Stage 9 usually has no human" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=8;shadow=1;" vertex="1"><mxGeometry as="geometry" x="40" y="350" width="420" height="380" /></mxCell><mxCell id="254" parent="1" value="&lt;b&gt;SCREEN 2: PATIENT 360&lt;/b&gt;&#10;&lt;b&gt;For: Oncologist · Stage: 3 (pre-consult chart review, 2-5 min)&lt;/b&gt;&#10;─────────────────────────────────────&#10;&#10;&lt;b&gt;TOP: GATE STRIP&lt;/b&gt; (answers all 6 questions in one glance)&#10;┌─────────┬──────────┬─────────┬──────────┬──────────┐&#10;│CLINICAL │SURVEILLNC│DOCUMENT │ COVERAGE │ IDENTITY │&#10;│  ● PASS │ ⚠ STALE │ ● PASS  │ ⚠ CONFL  │  ● PASS  │&#10;└─────────┴──────────┴─────────┴──────────┴──────────┘&#10;Each gate shows: pass | fail | not_evaluated | conflicting&#10;(not_evaluated is DISTINCT from pass — grey, not green)&#10;Click any gate → jumps to the evidence below&#10;&#10;&lt;b&gt;SECOND: FACILITY TIMELINE&lt;/b&gt;&#10;[Spoke: Dist Hosp Jhansi] → [Hub: CMC Vellore] → [Hub: TMH Jamshedpur]&#10;Shows which facility contributed what, when, and what's missing&#10;&#10;&lt;b&gt;THEN: Clinical sections in review order (L7)&lt;/b&gt;&#10;1. Pathology &amp;amp; biomarkers (IHC, FISH, grade — with discordance highlighted)&#10;2. Imaging (staging CT, PET, echo — with staleness flagged)&#10;3. Labs (CBC, renal, hepatic — normalized units, threshold comparison)&#10;4. Medications &amp;amp; treatment plan (current regimen, cycle #, plan version)&#10;5. Coverage &amp;amp; authorization (PM-JAY/insurer status + eligible schemes)&#10;6. Identity &amp;amp; consent (ID_MAP with link quality, consent status)&#10;&#10;Each section: hub record BESIDE spoke record.&#10;Disagreements shown as BOTH values with 'conflicting' badge.&#10;📄 real-patient-dipali.md: Grade II at spoke, III at hub — BOTH shown&#10;&#10;&lt;b&gt;What it prevents:&lt;/b&gt;&#10;• Oncologist missing a stale echo buried in the chart&#10;• HER2 discordance between labs going unnoticed&#10;• Treatment starting on a preliminary (not final) pathology result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=8;shadow=1;" vertex="1"><mxGeometry as="geometry" x="40" y="750" width="420" height="510" /></mxCell><mxCell id="255" parent="1" value="&lt;b&gt;SCREEN 3: ASK + EVIDENCE&lt;/b&gt;&#10;&lt;b&gt;For: Oncologist/Coordinator · Stage: 4, 9&lt;/b&gt;&#10;─────────────────────────────────────&#10;&#10;&lt;b&gt;LEFT: Question input&lt;/b&gt;&#10;Free-text question with known_as_of slider&#10;(always visible — can ask &quot;what was true at 9 AM?&quot;)&#10;&#10;&lt;b&gt;CENTER: Answer&lt;/b&gt;&#10;Each sentence carries evidence badge:&#10;[LAB-441] [DOC-004 p.2] [AUTH-007]&#10;Click any badge → right panel shows the exact source&#10;&#10;answer_status displayed at top:&#10;  ● SUPPORTED (all claims verified)&#10;  ⚠ PARTIAL (some claims couldn't be verified)&#10;  ⊘ INSUFFICIENT (not enough evidence to answer)&#10;&#10;NO confidence percentage. Ever.&#10;Instead: &quot;3 claims verified against 5 sources&quot;&#10;          &quot;2 sources disagree on HER2 status&quot;&#10;          &quot;Final pathology report not yet received&quot;&#10;&#10;&lt;b&gt;RIGHT: Evidence pane&lt;/b&gt;&#10;For structured evidence: the exact table row&#10;  (value, unit, date, source facility)&#10;For document evidence: the exact PDF page&#10;  with the relevant passage highlighted&#10;  and the char offsets marked&#10;&#10;&lt;b&gt;Class A questions:&lt;/b&gt;&#10;&quot;Should she take the treatment?&quot; →&#10;REFUSED. Shows: &quot;This question requires clinical&#10;judgment. Routing to treating team with evidence packet.&#10;Your treating team decides.&quot;&#10;&#10;&lt;b&gt;Regulatory questions:&lt;/b&gt;&#10;&quot;What does PM-JAY require before this claim?&quot; →&#10;Answered from REFERENCE corpus (not patient docs)&#10;Cited with page and clause from PM-JAY manual&#10;📄 reference-corpus-sources.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=8;shadow=1;" vertex="1"><mxGeometry as="geometry" x="500" y="350" width="420" height="480" /></mxCell><mxCell id="256" parent="1" value="&lt;b&gt;SCREEN 4: REVIEW + HISTORY&lt;/b&gt;&#10;&lt;b&gt;For: Coordinator · Stage: 9 (resolution)&lt;/b&gt;&#10;─────────────────────────────────────&#10;&#10;&lt;b&gt;TASK LIST:&lt;/b&gt;&#10;All tasks for this patient:&#10;  documentation_review → &quot;get the FISH addendum&quot;&#10;  record_request → &quot;requested from CMC Vellore on [date]&quot;&#10;  consult_request → &quot;cardiology consult for LVEF decline&quot;&#10;  scheme_referral → &quot;referred to Rashtriya Arogya Nidhi&quot;&#10;&#10;Each task shows:&#10;  status lifecycle → created → in_progress → completed&#10;  assigned_to, actor, decision, reason&#10;  evidence_ids attached to every action&#10;  idempotency_key (no duplicate actions)&#10;&#10;&lt;b&gt;VERSION CHAIN:&lt;/b&gt;&#10;For the selected patient, shows how the record evolved:&#10;  [Sep 5] Preliminary pathology: Grade II, IHC pending&#10;  [Sep 10] IHC addendum: ER+, PR-, HER2 2+ (equivocal)&#10;  [Oct 3] FISH addendum: HER2 NEGATIVE&#10;  [Oct 7] All reports printed as batch&#10;  [Nov 1] Tumor board: Stage IVA, plan changed&#10;&#10;&lt;b&gt;ANSWER_RUN HISTORY:&lt;/b&gt;&#10;&quot;This question was asked on [date] with known_as_of [time].&#10;At that moment, the answer was [X]. Today it is [Y].&#10;The difference: [document arrived / version changed].&quot;&#10;&#10;&lt;b&gt;What it prevents:&lt;/b&gt;&#10;• Tasks closed by memory instead of by evidence&#10;• No audit trail when things go wrong&#10;• Disputes about what was known when" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=8;shadow=1;" vertex="1"><mxGeometry as="geometry" x="500" y="850" width="420" height="440" /></mxCell><mxCell id="257" parent="1" value="&lt;b&gt;SCREEN 5: JUDGE CONSOLE&lt;/b&gt;&#10;&lt;b&gt;For: Hackathon judges · Proves every claim live&lt;/b&gt;&#10;─────────────────────────────────────&#10;&#10;&lt;b&gt;SECURITY PROBES&lt;/b&gt; (buttons, not reports)&#10;🔴 Cross-scope probe → 0 leakage + audit row&#10;🔴 Bypass-the-app probe → Snowflake refuses&#10;🔴 Injection probe → parsed as content&#10;🔴 Hallucination probe → claim stripped + logged&#10;&#10;&lt;b&gt;EVIDENCE PROBES&lt;/b&gt;&#10;🟡 Time-travel replay → slider, two correct answers&#10;🟡 Missing-evidence probe → degrades to partial&#10;🟡 Baseline delta → measured vs plain RAG&#10;&#10;&lt;b&gt;METRICS&lt;/b&gt; (live queries, not constants)&#10;📊 Evidence coverage: X/Y claims with evidence&#10;📊 Citation precision: X/Y citations verified&#10;📊 Leakage count: 0 (from QUERY_HISTORY)&#10;📊 Cost: ₹X.XX per answer, Y.Y seconds&#10;&#10;&lt;b&gt;COCO EVIDENCE INDEX&lt;/b&gt;&#10;Per-phase: session IDs, commits, query IDs&#10;Includes failures and fixes&#10;(the failure+fix pair is the most credible&#10;evidence of real CoCo usage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=8;shadow=1;" vertex="1"><mxGeometry as="geometry" x="960" y="350" width="380" height="380" /></mxCell><mxCell id="258" parent="1" value="&lt;b&gt;FAMILY VIEW (role-scoped)&lt;/b&gt;&#10;&lt;b&gt;For: Patient's caretaker · Stage: 1 (before travel)&lt;/b&gt;&#10;─────────────────────────────────────&#10;&#10;&lt;b&gt;BRING-LIST&lt;/b&gt;&#10;(translated to Hindi / Tamil / Bengali / Marathi&#10;via ❄️ Cortex TRANSLATE)&#10;&#10;Example:&#10;─────────&#10;✅ पिछली CBC रिपोर्ट (17 सितंबर)&#10;❌ FISH एडेंडम — अभी तक प्राप्त नहीं हुआ&#10;    (CMC वेल्लोर से अनुरोध करें)&#10;⚠️ बीमा प्राधिकरण — स्थिति: लंबित&#10;    (अस्पताल PM-JAY डेस्क से जांच करें)&#10;─────────&#10;&#10;IF coverage gap detected:&#10;💡 आप इन योजनाओं के लिए पात्र हो सकते हैं:&#10;   • राष्ट्रीय आरोग्य निधि (₹15 लाख तक)&#10;   • [राज्य योजना]&#10;   अस्पताल के चिकित्सा अधीक्षक से पूछें&#10;&#10;&lt;b&gt;RULES:&lt;/b&gt;&#10;• Shows ONLY coordinator-reviewed items&#10;• Evidence IDs = strict SUBSET of coordinator's&#10;• Class A always refused&#10;• Never shows raw clinical data&#10;• Every page: &quot;आपकी चिकित्सा टीम निर्णय लेती है&quot;&#10;  (Your treating team decides)&#10;&#10;&lt;b&gt;This is the #1 output for 85% of users.&lt;/b&gt;&#10;The caretaker carrying the folder 1,400 km&#10;is the actual user of this system.&#10;📄 lived-experience-patients.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=8;shadow=1;" vertex="1"><mxGeometry as="geometry" x="960" y="750" width="380" height="500" /></mxCell><mxCell id="259" parent="1" value="&lt;b&gt;COVERAGE GAP → SCHEME FINDER&lt;/b&gt;&#10;(inside Patient 360, Screen 2, Coverage section)&#10;─────────────────────────────────────&#10;&#10;When the coverage gate shows a GAP:&#10;&#10;⚠️ &lt;b&gt;PM-JAY ceiling: ₹4.2L used of ₹5L&lt;/b&gt;&#10;   Remaining: ₹80,000&#10;   Estimated cost of remaining treatment: ₹3.5L&#10;   &lt;b&gt;SHORTFALL: ₹2.7 lakh&lt;/b&gt;&#10;&#10;💡 &lt;b&gt;Potentially eligible schemes:&lt;/b&gt;&#10;&#10;   1. &lt;b&gt;Rashtriya Arogya Nidhi&lt;/b&gt; (Central Govt)&#10;      Covers: BPL families, life-threatening diseases&#10;      Max: ₹15 lakh&#10;      Apply: through hospital Medical Superintendent&#10;      📄 pmjay-oncology.md&#10;&#10;   2. &lt;b&gt;Tata Trusts Cancer Care Program&lt;/b&gt;&#10;      Covers: financial assistance for cancer treatment&#10;      Apply: through hospital social worker&#10;&#10;   3. &lt;b&gt;Indian Cancer Society&lt;/b&gt;&#10;      Covers: partial financial assistance&#10;      Apply: icsindia.org&#10;&#10;   ⚠️ Eligibility is indicative. Verify with the scheme office.&#10;&#10;&lt;b&gt;WHY THIS WINS THE ROOM:&lt;/b&gt;&#10;84% face catastrophic expenditure.&#10;This is the moment the system stops being&#10;technology and starts being hope.&#10;No competitor has this. Not one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=8;shadow=1;" vertex="1"><mxGeometry as="geometry" x="500" y="1310" width="420" height="360" /></mxCell></root></mxGraphModel></diagram></mxfile>