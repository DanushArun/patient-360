<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-16T18:00:00.000Z" agent="SAARTHI-CoCo" type="device"><diagram name="Data Pipeline" id="pipeline-1"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="120" parent="1" value="&lt;b&gt;SAARTHI — Data Pipeline Architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1"><mxGeometry as="geometry" x="40" y="20" width="700" height="35" /></mxCell><mxCell id="121" parent="1" value="Every step from synthetic data generation to validated answer. Snowflake features annotated with ❄️. Research sources annotated with 📄." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#64748B;" vertex="1"><mxGeometry as="geometry" x="40" y="55" width="900" height="25" /></mxCell><mxCell id="122" parent="1" value="&lt;b&gt;LOCAL — Synthetic Data Generation&lt;/b&gt;  (runs on developer's machine, NOT in Snowflake)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#92400E;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#92400E;verticalAlign=top;spacingTop=12;spacingLeft=12;align=left;arcSize=4;dashed=1;" vertex="1"><mxGeometry as="geometry" x="30" y="100" width="1540" height="220" /></mxCell><mxCell id="123" parent="1" value="&lt;b&gt;FACT LEDGER&lt;/b&gt;&#10;ledger.py&#10;─────────&#10;Seeded (seed=17) canonical&#10;event history.&#10;&#10;Single source of truth:&#10;everything downstream is&#10;derived from this.&#10;&#10;Also generates the EVAL&#10;truth key — the ledger IS&#10;the answer key." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="50" y="140" width="190" height="160" /></mxCell><mxCell id="124" parent="1" value="&lt;b&gt;SOURCE PROJECTIONS&lt;/b&gt;&#10;projections.py&#10;─────────&#10;From one patient, generates:&#10;• Hub hospital MRN&#10;• Spoke hospital MRN&#10;• PM-JAY beneficiary ID&#10;• Insurer member ID&#10;• ABHA (20% of patients)&#10;&#10;📄 real-patient-dipali.md:&#10;7 identifiers, 0 ABHA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="270" y="140" width="200" height="160" /></mxCell><mxCell id="125" parent="1" value="&lt;b&gt;DOCUMENT RENDERER&lt;/b&gt;&#10;documents.py&#10;─────────&#10;Renders PDFs from the&#10;SAME facts as the tables.&#10;Pathology, discharge summary,&#10;auth letters, lab reports.&#10;&#10;Includes Indian format variants:&#10;• GM% units, /CUMM&#10;• Lakh comma notation&#10;• SGOT/SGPT naming&#10;• Mixed Hindi/English headers&#10;&#10;📄 lab-reporting-india.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="500" y="130" width="210" height="170" /></mxCell><mxCell id="126" parent="1" value="&lt;b&gt;CORRUPTION INJECTOR&lt;/b&gt;&#10;corruptions.py&#10;─────────&#10;12 named scenarios from&#10;Dipali's REAL reports:&#10;&#10;1. Grade discordance (II vs III)&#10;2. IHC discordance (HER2 1+ vs 2+)&#10;3. Late addendum arrival&#10;4. Stale echo (&gt;90 days)&#10;5. Auth table/letter conflict&#10;6. Unit mismatch between labs&#10;7. Consolidated batch printout&#10;8. Handwritten + printed mix&#10;9. Treatment plan change&#10;10. Complication gap (appendectomy)&#10;11. Identity ambiguity&#10;12. Embedded prompt injection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="740" y="120" width="230" height="190" /></mxCell><mxCell id="127" parent="1" value="&lt;b&gt;REFERENCE DOCUMENTS&lt;/b&gt;&#10;(real, public, downloadable)&#10;─────────&#10;Tier 1 (must have):&#10;• PM-JAY Operation Manual&#10;• Trastuzumab FDA label&#10;• NCG Breast Cancer Guidelines&#10;&#10;Tier 2 (should have):&#10;• DPDP Act 2023&#10;• NHCX Specification&#10;• NMC Telemedicine Guidelines&#10;&#10;📄 reference-corpus-sources.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;strokeDasharray=4 3;" vertex="1"><mxGeometry as="geometry" x="1000" y="130" width="220" height="170" /></mxCell><mxCell id="128" parent="1" value="&lt;b&gt;SCHEME REGISTRY&lt;/b&gt;&#10;(hand-curated reference data)&#10;─────────&#10;~15-20 entries:&#10;• PM-JAY&#10;• Rashtriya Arogya Nidhi&#10;• State schemes (Arogyasri,&#10;  Yeshasvini, CMCHIS)&#10;• NGOs (CanSupport, Indian&#10;  Cancer Society, Tata Trusts)&#10;• Pharma assistance programs&#10;&#10;📄 brainstorm-decisions.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;strokeDasharray=4 3;" vertex="1"><mxGeometry as="geometry" x="1250" y="130" width="220" height="170" /></mxCell><mxCell id="129" parent="1" value="derives" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="123" target="124"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="130" parent="1" value="renders" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="123" target="125"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="131" parent="1" value="corrupts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="123" target="126"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="132" parent="1" value="&lt;b&gt;SNOWFLAKE ACCOUNT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0F172A;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#0F172A;verticalAlign=top;spacingTop=12;spacingLeft=12;align=left;arcSize=4;dashed=0;" vertex="1"><mxGeometry as="geometry" x="30" y="360" width="1540" height="1440" /></mxCell><mxCell id="133" parent="1" value="&lt;b&gt;RAW SCHEMA&lt;/b&gt;  —  immutable source data, never modified after load" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1;fontSize=12;fontStyle=1;fontColor=#475569;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;arcSize=4;strokeDasharray=6 3;" vertex="1"><mxGeometry as="geometry" x="50" y="400" width="1500" height="240" /></mxCell><mxCell id="134" parent="1" value="&lt;b&gt;❄️ Internal Stage&lt;/b&gt;&#10;@SAARTHI_RAW&#10;─────────&#10;CSV + PDF + JSON files&#10;File-hashed at upload&#10;Immutable — source of truth&#10;&#10;❄️ COPY INTO for structured&#10;❄️ Stage for documents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="70" y="440" width="200" height="170" /></mxCell><mxCell id="135" parent="1" value="&lt;b&gt;❄️ Raw Tables&lt;/b&gt;&#10;─────────&#10;PATIENT (canonical ID, ABHA ref)&#10;ID_MAP (source_system → patient)&#10;ENCOUNTER (scheduled + actual time)&#10;CLINICAL_EVENT (labs, imaging, meds)&#10;COVERAGE (PM-JAY, private insurance)&#10;AUTHORIZATION (pre-auth lifecycle)&#10;DOCUMENT (scope, version, 3 clocks)&#10;FACILITY_REGISTRY (hub/spoke/lab)&#10;SCHEME_REGISTRY (govt/NGO/pharma)&#10;TREATMENT_PLAN (versioned, with reason)&#10;CONSENT (purpose, status, checked at query)&#10;&#10;&lt;b&gt;Every table has 3 timestamp columns:&lt;/b&gt;&#10;event_time · source_recorded_at · ingested_at&#10;(R2 — no competitor has this)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="300" y="435" width="290" height="185" /></mxCell><mxCell id="136" parent="1" value="&lt;b&gt;❄️ Raw DOCUMENT table&lt;/b&gt;&#10;─────────&#10;doc_id, patient_id, scope,&#10;doc_type, version, accession_id,&#10;file_hash, source_facility,&#10;ingestion_method,&#10;signed_at, effective_at, ingested_at,&#10;supersedes_doc_id&#10;&#10;&lt;b&gt;scope = 'patient' | 'reference'&lt;/b&gt;&#10;(R6 — corpus separation starts HERE)&#10;&#10;&lt;b&gt;ingestion_method:&lt;/b&gt;&#10;digital_emr | physical_folder |&#10;whatsapp_photo | downloaded_pdf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="620" y="435" width="260" height="185" /></mxCell><mxCell id="137" parent="1" value="&lt;b&gt;❄️ Stream&lt;/b&gt;&#10;on DOCUMENT&#10;─────────&#10;Detects new/changed docs&#10;Triggers parsing task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="920" y="470" width="160" height="80" /></mxCell><mxCell id="138" parent="1" value="&lt;b&gt;❄️ Internal Stage&lt;/b&gt;&#10;@SAARTHI_REFERENCE&#10;─────────&#10;Real regulatory PDFs&#10;Physically separate from&#10;patient documents&#10;(R6 — structural separation)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="1110" y="450" width="200" height="120" /></mxCell><mxCell id="139" parent="1" value="❄️ COPY INTO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="134" target="135"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="140" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="135" target="136"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="141" parent="1" value="CDC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="136" target="137"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="142" parent="1" value="&lt;b&gt;R2&lt;/b&gt; Three Clocks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=9;fontColor=#1E40AF;fontStyle=1;arcSize=50;" vertex="1"><mxGeometry as="geometry" x="530" y="615" width="90" height="18" /></mxCell><mxCell id="143" parent="1" value="&lt;b&gt;R6&lt;/b&gt; Dual Corpus" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=9;fontColor=#1E40AF;fontStyle=1;arcSize=50;" vertex="1"><mxGeometry as="geometry" x="830" y="570" width="90" height="18" /></mxCell><mxCell id="144" parent="1" value="&lt;b&gt;R6&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=9;fontColor=#1E40AF;fontStyle=1;arcSize=50;" vertex="1"><mxGeometry as="geometry" x="1230" y="570" width="40" height="18" /></mxCell><mxCell id="145" parent="1" value="&lt;b&gt;DOCUMENT PROCESSING&lt;/b&gt;  —  ❄️ Tasks + Streams (NOT Dynamic Tables — AI steps are non-deterministic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1;fontSize=12;fontStyle=1;fontColor=#475569;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;arcSize=4;strokeDasharray=6 3;" vertex="1"><mxGeometry as="geometry" x="50" y="660" width="1500" height="250" /></mxCell><mxCell id="146" parent="1" value="&lt;b&gt;❄️ Task: PARSE_DOCUMENTS&lt;/b&gt;&#10;─────────&#10;Calls AI_PARSE_DOCUMENT&#10;mode = LAYOUT&#10;page_split = TRUE&#10;&#10;Input: PDF from stage&#10;Output: DOC_PAGE rows&#10;(one per page, markdown text)&#10;&#10;Handles: rotated photos,&#10;mixed Hindi/English, tables,&#10;handwritten sections&#10;&#10;Cost: 1 credit/page&#10;📄 platform-constraints.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="70" y="700" width="230" height="190" /></mxCell><mxCell id="147" parent="1" value="&lt;b&gt;❄️ Task: EXTRACT_ASSERTIONS&lt;/b&gt;&#10;─────────&#10;Calls AI_COMPLETE (typed extraction)&#10;&#10;Input: DOC_PAGE text&#10;Output: ASSERTION rows:&#10;  subject, predicate, value, unit,&#10;  negation, missingness_state,&#10;  extractor_version,&#10;  char_start, char_end,&#10;  page_index, specimen_id&#10;&#10;&lt;b&gt;missingness_state enum:&lt;/b&gt;&#10;present · explicitly_negative ·&#10;pending · not_received ·&#10;conflicting · unreadable · superseded&#10;&#10;&lt;b&gt;R3 — missingness is a type, not NULL&lt;/b&gt;&#10;&quot;HER2 not received&quot; ≠ &quot;HER2 negative&quot;&#10;Getting this wrong = wrong treatment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="330" y="695" width="260" height="200" /></mxCell><mxCell id="148" parent="1" value="&lt;b&gt;❄️ Task: RECONCILE_EVIDENCE&lt;/b&gt;&#10;─────────&#10;Deterministic SQL (no AI)&#10;&#10;Input: ASSERTION rows&#10;Output: EVIDENCE_LINK rows:&#10;  assertion_id → target_id&#10;  relation: supports |&#10;    conflicts_with | supersedes&#10;&#10;Detects:&#10;• Addendum superseding preliminary&#10;• Grade discordance between specimens&#10;• IHC discordance between labs&#10;• Value conflicts (two labs, two values)&#10;&#10;📄 real-patient-dipali.md&#10;(all patterns from real reports)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="620" y="700" width="250" height="185" /></mxCell><mxCell id="149" parent="1" value="&lt;b&gt;Unit Normalization&lt;/b&gt;&#10;(applied during extraction)&#10;─────────&#10;lakhs → cells/µL&#10;GM% → g/dL&#10;mg% → mg/dL&#10;/CUMM → /µL&#10;SGOT → AST&#10;SGPT → ALT&#10;1,50,000 → 150000&#10;L/H flags stripped&#10;&#10;📄 lab-reporting-india.md&#10;📄 real-patient-dipali.md" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#FEF9C3;strokeColor=#CA8A04;fontSize=9;fontColor=#713F12;align=left;spacingLeft=6;spacingTop=4;spacingRight=4;" vertex="1"><mxGeometry as="geometry" x="900" y="700" width="190" height="185" /></mxCell><mxCell id="150" parent="1" value="&lt;b&gt;❄️ Task: PARSE_REFERENCE&lt;/b&gt;&#10;─────────&#10;AI_PARSE_DOCUMENT on&#10;regulatory PDFs&#10;&#10;Output: REF_DOC_PAGE&#10;Separate table from DOC_PAGE&#10;&#10;&lt;b&gt;NEVER mixed with patient&#10;document pages (R6)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="1120" y="700" width="210" height="130" /></mxCell><mxCell id="151" parent="1" value="&lt;b&gt;❄️ Stream&lt;/b&gt; on ASSERTION&#10;Triggers reconciliation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="555" y="880" width="160" height="30" /></mxCell><mxCell id="152" parent="1" value="triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="137" target="146"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="153" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="146" target="147"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="154" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="147" target="148"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="155" parent="1" value="CDC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="147" target="151"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="156" parent="1" value="triggers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="151" target="148"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="157" parent="1" value="&lt;b&gt;R3&lt;/b&gt; Typed Missingness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=9;fontColor=#1E40AF;fontStyle=1;arcSize=50;" vertex="1"><mxGeometry as="geometry" x="540" y="895" width="110" height="18" /></mxCell><mxCell id="158" parent="1" value="&lt;b&gt;HARMONIZED SCHEMA&lt;/b&gt;  —  ❄️ Dynamic Tables (deterministic SQL, auto-refreshing, TARGET_LAG = '1 minute')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1;fontSize=12;fontStyle=1;fontColor=#475569;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;arcSize=4;strokeDasharray=6 3;" vertex="1"><mxGeometry as="geometry" x="50" y="930" width="1500" height="200" /></mxCell><mxCell id="159" parent="1" value="&lt;b&gt;❄️ Dynamic Table&lt;/b&gt;&#10;&lt;b&gt;HARMONIZED_EVENT&lt;/b&gt;&#10;─────────&#10;Normalized clinical events&#10;Canonical units applied&#10;Specimen-level tracking&#10;Source facility tagged&#10;&#10;TARGET_LAG = '1 minute'&#10;(shows live refresh in demo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="70" y="970" width="230" height="140" /></mxCell><mxCell id="160" parent="1" value="&lt;b&gt;❄️ Dynamic Table&lt;/b&gt;&#10;&lt;b&gt;READINESS_GATE&lt;/b&gt;&#10;─────────&#10;5 gates per patient per encounter:&#10;Clinical · Surveillance ·&#10;Documentation · Coverage · Identity&#10;&#10;Outcome: pass | fail |&#10;not_evaluated | conflicting&#10;&#10;Each carries: rule_id, rule_version,&#10;input values, evidence_ids&#10;&#10;TARGET_LAG = DOWNSTREAM&#10;&#10;&lt;b&gt;R1 — every gate is SQL, never LLM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="340" y="960" width="260" height="155" /></mxCell><mxCell id="161" parent="1" value="&lt;b&gt;❄️ Dynamic Table&lt;/b&gt;&#10;&lt;b&gt;REVIEW_QUEUE&lt;/b&gt;&#10;─────────&#10;All patients with open gate failures&#10;Weighted by days-to-next-visit&#10;Assigned owner (coordinator)&#10;&#10;Labelled: &quot;documentation &amp;amp; coverage&#10;review priority&quot;&#10;&lt;b&gt;NEVER called &quot;patient risk&quot;&lt;/b&gt;&#10;(it doesn't model clinical risk)&#10;&#10;TARGET_LAG = DOWNSTREAM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="640" y="960" width="240" height="155" /></mxCell><mxCell id="162" parent="1" value="&lt;b&gt;❄️ Dynamic Table&lt;/b&gt;&#10;&lt;b&gt;SCHEME_ELIGIBILITY&lt;/b&gt;&#10;─────────&#10;For each patient with a&#10;coverage gap:&#10;matches eligible schemes&#10;from SCHEME_REGISTRY&#10;&#10;Deterministic SQL:&#10;state + income + diagnosis&#10;+ age + coverage_gap&#10;→ eligible scheme list&#10;&#10;📄 brainstorm-decisions.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="920" y="960" width="230" height="155" /></mxCell><mxCell id="163" parent="1" value="&lt;b&gt;❄️ Dynamic Table&lt;/b&gt;&#10;&lt;b&gt;CURRENT_TREATMENT_PLAN&lt;/b&gt;&#10;─────────&#10;Latest plan version per patient&#10;Regimen, cycle count,&#10;modifications with dates/reasons&#10;&#10;📄 real-patient-dipali.md:&#10;4 plan changes in 18 months&#10;(surgery → CMC plan → TMH&#10;tumor board → post-chemo HT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="1190" y="960" width="230" height="155" /></mxCell><mxCell id="164" parent="1" value="feeds" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="148" target="159"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="165" parent="1" value="DOWNSTREAM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="159" target="160"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="166" parent="1" value="DOWNSTREAM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="160" target="161"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="167" parent="1" value="&lt;b&gt;R1&lt;/b&gt; LLM Never Decides" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=9;fontColor=#1E40AF;fontStyle=1;arcSize=50;" vertex="1"><mxGeometry as="geometry" x="545" y="1115" width="120" height="18" /></mxCell><mxCell id="168" parent="1" value="&lt;b&gt;SEARCH &amp;amp; ANALYTICS&lt;/b&gt;  —  ❄️ Cortex Search (2 services, NEVER merged) + ❄️ Cortex Analyst (Semantic View)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1;fontSize=12;fontStyle=1;fontColor=#475569;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;arcSize=4;strokeDasharray=6 3;" vertex="1"><mxGeometry as="geometry" x="50" y="1150" width="1500" height="180" /></mxCell><mxCell id="169" parent="1" value="&lt;b&gt;❄️ Cortex Search Service&lt;/b&gt;&#10;&lt;b&gt;PATIENT_EVIDENCE&lt;/b&gt;&#10;─────────&#10;Indexed: DOC_PAGE (scope='patient')&#10;Attributes: patient_id, doc_id,&#10;page_index, doc_version&#10;&#10;⚠️ Runs with OWNER'S RIGHTS&#10;(ignores row access policies)&#10;→ App role has NO USAGE&#10;→ Access only through procedure&#10;→ Filter injected server-side&#10;&#10;📄 platform-constraints.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="70" y="1190" width="280" height="120" /></mxCell><mxCell id="170" parent="1" value="&lt;b&gt;❄️ Cortex Search Service&lt;/b&gt;&#10;&lt;b&gt;REFERENCE_CORPUS&lt;/b&gt;&#10;─────────&#10;Indexed: REF_DOC_PAGE&#10;Attributes: jurisdiction,&#10;effective_date, doc_type&#10;&#10;Contains: PM-JAY manual,&#10;trastuzumab label, NCG guidelines,&#10;DPDP Act, NMC guidelines&#10;&#10;&lt;b&gt;NO patient data in this service&lt;/b&gt;&#10;&lt;b&gt;R6 — structurally separate&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="390" y="1190" width="270" height="120" /></mxCell><mxCell id="171" parent="1" value="&lt;b&gt;❄️ Semantic View + Cortex Analyst&lt;/b&gt;&#10;&lt;b&gt;SAARTHI_COHORT&lt;/b&gt;&#10;─────────&#10;For cohort/aggregate questions:&#10;&quot;Which patients this week lack a final report?&quot;&#10;&quot;How many upcoming visits have coverage gaps?&quot;&#10;&#10;❄️ Verified Query Repository (5 pre-verified)&#10;❄️ Policies propagate from base tables&#10;❄️ Aggregation policy prevents re-identification&#10;&#10;📄 snowflake-implementation-patterns.md §3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="700" y="1185" width="330" height="130" /></mxCell><mxCell id="172" parent="1" value="&lt;b&gt;❄️ TASK + REVIEW_ISSUE Tables&lt;/b&gt;&#10;─────────&#10;TASK types:&#10;• documentation_review&#10;• evidence_received&#10;• consult_request (→ dept)&#10;• record_request (→ facility)&#10;• scheme_referral (→ patient)&#10;&#10;Idempotency key on every write&#10;Audit trail with actor + timestamp&#10;&#10;❄️ Row Access Policy applied" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="1070" y="1190" width="240" height="120" /></mxCell><mxCell id="173" parent="1" value="&lt;b&gt;R5&lt;/b&gt; Three-Layer Defense" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=9;fontColor=#1E40AF;fontStyle=1;arcSize=50;" vertex="1"><mxGeometry as="geometry" x="70" y="1310" width="130" height="18" /></mxCell><mxCell id="174" parent="1" value="&lt;b&gt;R6&lt;/b&gt; Never Merged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=9;fontColor=#1E40AF;fontStyle=1;arcSize=50;" vertex="1"><mxGeometry as="geometry" x="600" y="1310" width="100" height="18" /></mxCell><mxCell id="175" parent="1" value="&lt;b&gt;INTELLIGENCE LAYER&lt;/b&gt;  —  Question classification → Tool selection → Answer generation → Validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1;fontSize=12;fontStyle=1;fontColor=#475569;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;arcSize=4;strokeDasharray=6 3;" vertex="1"><mxGeometry as="geometry" x="50" y="1350" width="1500" height="270" /></mxCell><mxCell id="176" parent="1" value="&lt;b&gt;CLASS A/B CLASSIFIER&lt;/b&gt;&#10;─────────&#10;&lt;b&gt;Class A (clinical judgment):&lt;/b&gt;&#10;&quot;Should she take the treatment?&quot;&#10;&quot;Is this drug interaction dangerous?&quot;&#10;→ ALWAYS REFUSED, every role&#10;→ Routed to treating team&#10;   with evidence packet&#10;&#10;&lt;b&gt;Class B (record state):&lt;/b&gt;&#10;&quot;What's missing from the record?&quot;&#10;&quot;Has the authorization arrived?&quot;&#10;&quot;What does PM-JAY require?&quot;&#10;→ Answered with citations&#10;&#10;10 edge cases pre-mapped:&#10;📄 should-close-gaps.md §3&#10;&#10;Legal basis: NMC Act 2019&#10;📄 law-nmc-clinical-practice.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="70" y="1390" width="250" height="210" /></mxCell><mxCell id="177" parent="1" value="&lt;b&gt;❄️ 6 SQL Procedures&lt;/b&gt;&#10;(scope as bound parameter on EVERY one)&#10;─────────&#10;1. get_patient_facts&#10;   (patient_id, domain, known_as_of)&#10;2. get_readiness&#10;   (patient_id, encounter_id, known_as_of)&#10;3. search_patient_documents&#10;   (patient_id, query, known_as_of)&#10;4. search_reference_documents&#10;   (query, jurisdiction, effective_date)&#10;5. cohort_query&#10;   (question)&#10;6. create_review_task&#10;   (..., idempotency_key)&#10;&#10;Procedures 1-3: scope derived from&#10;CURRENT_USER() + ROLE_PATIENT_MAP&#10;Procedure 4: no patient scope needed&#10;Procedure 6: requires explicit user action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="350" y="1385" width="260" height="220" /></mxCell><mxCell id="178" parent="1" value="&lt;b&gt;DETERMINISTIC ROUTER&lt;/b&gt;&#10;(PRIMARY path)&#10;─────────&#10;1. Classify question (A/B)&#10;2. If A → refuse&#10;3. If B → select tool&#10;4. Call procedure with&#10;   bound scope&#10;5. Format response&#10;&#10;No LLM in the routing decision.&#10;The router is more defensible&#10;than an agent under R1 and R5.&#10;&#10;&quot;How do you know it can't query&#10;outside scope?&quot; → &quot;The scope is&#10;a bound parameter in a stored&#10;procedure.&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="640" y="1390" width="220" height="200" /></mxCell><mxCell id="179" parent="1" value="&lt;b&gt;❄️ Cortex Agent&lt;/b&gt;&#10;(LAYER on top, when confirmed)&#10;─────────&#10;Wraps the same 6 procedures&#10;with natural language understanding.&#10;&#10;❄️ AGENT_RUN() callable from SQL&#10;(de-risks container runtime)&#10;&#10;❄️ Immutable session attributes&#10;for patient scope (R5)&#10;&#10;The agent adds NLU convenience.&#10;The router adds safety.&#10;Both call the same procedures." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="890" y="1390" width="230" height="170" /></mxCell><mxCell id="180" parent="1" value="&lt;b&gt;ANSWER VALIDATOR&lt;/b&gt;&#10;(runs AFTER generation, BEFORE display)&#10;─────────&#10;5 checks, in order:&#10;&#10;&lt;b&gt;1. Evidence existence&lt;/b&gt;&#10;   Every claim ≥1 evidence ID&#10;&#10;&lt;b&gt;2. Scope membership&lt;/b&gt;&#10;   ID belongs to bound patient&#10;&#10;&lt;b&gt;3. Version currency&lt;/b&gt;&#10;   Within known_as_of window&#10;&#10;&lt;b&gt;4. Polarity (❄️ AI_FILTER)&lt;/b&gt;&#10;   &quot;no history&quot; ≠ &quot;history&quot;&#10;&#10;&lt;b&gt;5. Type match&lt;/b&gt;&#10;   Numeric/date/status check&#10;&#10;Fails closed: unsupported →&#10;STRIPPED + explicit limitation&#10;+ removal LOGGED&#10;&#10;answer_status:&#10;supported | partial | insufficient&#10;&#10;📄 polarity-checking-implementation.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="1150" y="1375" width="230" height="240" /></mxCell><mxCell id="181" parent="1" value="Class B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="176" target="177"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="182" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="177" target="178"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="183" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#475569;strokeWidth=1.5;fontSize=9;fontColor=#475569;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="178" target="179"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="184" parent="1" value="&lt;b&gt;REFUSED&lt;/b&gt;&#10;→ treating team&#10;+ evidence packet&#10;+ &quot;your treating team decides&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#B91C1C;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="70" y="1600" width="250" height="30" /></mxCell><mxCell id="185" parent="1" value="Class A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#DC2626;strokeWidth=2;fontSize=9;fontColor=#DC2626;fontStyle=1;" edge="1" source="176" target="184"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="186" parent="1" value="&lt;b&gt;OUTPUT &amp;amp; AUDIT&lt;/b&gt;  —  ❄️ ANSWER_RUN (legal compliance artifact) + ❄️ Cortex Guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#94A3B8;strokeWidth=1;fontSize=12;fontStyle=1;fontColor=#475569;verticalAlign=top;spacingTop=10;spacingLeft=10;align=left;arcSize=4;strokeDasharray=6 3;" vertex="1"><mxGeometry as="geometry" x="50" y="1640" width="1500" height="130" /></mxCell><mxCell id="187" parent="1" value="&lt;b&gt;❄️ ANSWER_RUN Table&lt;/b&gt;&#10;─────────&#10;Persisted for every answer generated.&#10;&#10;Stores POINTERS, not content:&#10;question, role, scope, known_as_of,&#10;claim→evidence_id map,&#10;validation_results, model_version, timing&#10;&#10;&lt;b&gt;Why pointers not content:&lt;/b&gt;&#10;DPDP Rule 6(e) requires ≥1 year log retention.&#10;DPDP s.12 requires erasure on request.&#10;If we store the answer text, erasure and&#10;retention collide. Pointers let us delete&#10;content while the access record survives.&#10;&#10;📄 law-dpdp.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="70" y="1670" width="350" height="80" /></mxCell><mxCell id="188" parent="1" value="&lt;b&gt;❄️ Cortex Guard&lt;/b&gt;&#10;─────────&#10;On every generation call.&#10;Model safety flag.&#10;Closes &quot;what if the model&#10;says something harmful?&quot;&#10;&#10;One flag. One line of code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="460" y="1680" width="200" height="60" /></mxCell><mxCell id="189" parent="1" value="&lt;b&gt;❄️ QUERY_HISTORY&lt;/b&gt;&#10;─────────&#10;Live leakage proof.&#10;(ACCESS_HISTORY lags 180 min)&#10;&#10;Shows base tables were never&#10;touched outside scope.&#10;Unfakeable — Snowflake's own log.&#10;&#10;📄 platform-constraints.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1;fontSize=10;fontColor=#1E293B;verticalAlign=top;spacingTop=6;spacingLeft=6;align=left;arcSize=6;" vertex="1"><mxGeometry as="geometry" x="700" y="1670" width="220" height="80" /></mxCell><mxCell id="190" parent="1" value="&lt;b&gt;❄️ Snowflake Features Used: 14&lt;/b&gt;&#10;Cortex Search (×2) · Cortex Analyst · Cortex Agent · Cortex Guard ·&#10;AI_PARSE_DOCUMENT · AI_COMPLETE · AI_FILTER · Cortex TRANSLATE ·&#10;Dynamic Tables (×5) · Streams (×2) · Tasks (×3) · Semantic View + VQR ·&#10;Row Access Policies · Masking Policies + Tags · QUERY_HISTORY ·&#10;Git Integration · Internal Stages (×2) · Stored Procedures (×6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1;fontSize=8;fontColor=#0369A1;fontStyle=1;arcSize=50;" vertex="1"><mxGeometry as="geometry" x="960" y="1680" width="500" height="60" /></mxCell></root></mxGraphModel></diagram></mxfile>