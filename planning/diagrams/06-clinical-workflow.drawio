        <mxCell id="18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#6366F1;strokeWidth=1;fontSize=10;fontColor=#1F2937;verticalAlign=middle;arcSize=8;" value="&lt;b&gt;Stage 3&lt;/b&gt;&lt;br/&gt;Pre-consult&#xa;Chart Review&lt;br/&gt;&lt;font point-size=&#39;9&#39; color=&#39;#64748B&#39;&gt;Oncologist reviews record&#xa;2-5 minutes&lt;/font&gt;" vertex="1">
