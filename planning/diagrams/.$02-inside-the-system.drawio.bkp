          <mxGeometry height="68" width="215" x="1009" y="890" as="geometry" />
        </mxCell>
        <mxCell id="b7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D9A441;dashed=1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;" value="" vertex="1">
          <mxGeometry height="110" width="1030" x="210" y="984" as="geometry" />
        </mxCell>
        <mxCell id="b7n" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#FCD34D;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="7" vertex="1">
          <mxGeometry height="30" width="60" x="130" y="988" as="geometry" />
        </mxCell>
        <mxCell id="b7l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#B45309;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="THE PROOF CHECK" vertex="1">
          <mxGeometry height="16" width="400" x="226" y="994" as="geometry" />
        </mxCell>
        <mxCell id="b7d" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=2;fontColor=#B45309;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="The only step that can delete the answer&#39;s own words." vertex="1">
          <mxGeometry height="14" width="900" x="226" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="pc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;Every sentence must name the page or the row behind it.&lt;/b&gt;&amp;nbsp;&amp;nbsp;A sentence with no proof is deleted before anyone sees it, and the deletion is written down.&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Answers come back as: &lt;b&gt;proven&lt;/b&gt; · &lt;b&gt;partly proven&lt;/b&gt; · &lt;b&gt;not enough information&lt;/b&gt;. Never a percentage, because a percentage cannot be checked.&lt;/font&gt;" vertex="1">
          <mxGeometry height="47" width="998" x="226" y="1034" as="geometry" />
        </mxCell>
        <mxCell id="b8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;dashed=1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;" value="" vertex="1">
          <mxGeometry height="153" width="1030" x="210" y="1108" as="geometry" />
        </mxCell>
        <mxCell id="b8n" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#CBD5E1;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="8" vertex="1">
          <mxGeometry height="30" width="60" x="130" y="1112" as="geometry" />
        </mxCell>
        <mxCell id="b8l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2937;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="WHAT PEOPLE SEE, AND WHAT GETS DONE" vertex="1">
          <mxGeometry height="16" width="500" x="226" y="1118" as="geometry" />
        </mxCell>
        <mxCell id="b8d" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=2;fontColor=#64748B;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="A gap becomes a named task with an owner and a date. Closing it needs a person. No medical order is ever created by this system." vertex="1">
          <mxGeometry height="14" width="1000" x="226" y="1134" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;Today&#39;s review list&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;who needs attention before their visit, and why&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="196" x="226" y="1158" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;One patient&#39;s full picture&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;the checks first, then pathology, scans, bloods, history&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="196" x="434" y="1158" as="geometry" />
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;Ask a question&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;answer with the proof beside it; refuses medical advice&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="196" x="642" y="1158" as="geometry" />
        </mxCell>
        <mxCell id="s4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;Chase and close gaps&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;task, owner, deadline, and a record of who closed it&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="196" x="850" y="1158" as="geometry" />
        </mxCell>
        <mxCell id="s5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;Message the family&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;before they travel: exactly what to bring. Checked by a person first&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="166" x="1058" y="1158" as="geometry" />
        </mxCell>
        <mxCell id="a1" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94A3B8;endArrow=block;endFill=1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;">
