        <mxCell id="b5l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2937;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="THE CHECKS — IS THIS PATIENT READY?" vertex="1">
          <mxGeometry height="16" width="400" x="226" y="706" as="geometry" />
        </mxCell>
        <mxCell id="b5d" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=2;fontColor=#64748B;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="Each check is a written rule with a version number, run in the database. No model decides any of these. Each answers: yes · no · cannot tell · sources disagree." vertex="1">
          <mxGeometry height="14" width="1000" x="226" y="722" as="geometry" />
        </mxCell>
