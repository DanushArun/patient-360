        </mxCell>
        <mxCell id="i2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;From the lab and scan rooms&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;reports the moment they are signed&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="247" x="487" y="150" as="geometry" />
