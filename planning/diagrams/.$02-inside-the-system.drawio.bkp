          <mxGeometry height="30" width="60" x="130" y="248" as="geometry" />
        </mxCell>
        <mxCell id="b2l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#B45309;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="ARE WE ALLOWED TO HOLD THIS?" vertex="1">
          <mxGeometry height="16" width="400" x="226" y="254" as="geometry" />
        </mxCell>
        <mxCell id="b2d" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=2;fontColor=#B45309;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="Required by the Digital Personal Data Protection Act 2023. No permission means no data — the system returns nothing rather than guessing." vertex="1">
          <mxGeometry height="14" width="900" x="226" y="270" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;Permission check&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;is there a valid, unexpired permission covering this patient, this purpose, these dates?&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="330" x="226" y="294" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;Permission record&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;who gave it, for what, to whom, until when — kept as evidence&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="330" x="570" y="294" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;Taking permission back&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;the patient can withdraw; data stops being served and we can prove the moment it stopped&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="310" x="914" y="294" as="geometry" />
        </mxCell>
        <mxCell id="b3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;dashed=1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;" value="" vertex="1">
          <mxGeometry height="130" width="1030" x="210" y="388" as="geometry" />
        </mxCell>
        <mxCell id="b3n" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#CBD5E1;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="3" vertex="1">
          <mxGeometry height="30" width="60" x="130" y="392" as="geometry" />
        </mxCell>
        <mxCell id="b3l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2937;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="WHOSE RECORD IS THIS?" vertex="1">
          <mxGeometry height="16" width="400" x="226" y="398" as="geometry" />
        </mxCell>
        <mxCell id="b3d" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=2;fontColor=#64748B;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="Never matched on name and date of birth alone. A wrong merge in cancer care cannot be undone — so when unsure, the system refuses to merge." vertex="1">
          <mxGeometry height="14" width="900" x="226" y="414" as="geometry" />
        </mxCell>
        <mxCell id="id1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;Match to one person&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;national health ID, this hospital&#39;s number, the number the last hospital used, scheme and insurer IDs&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="330" x="226" y="437" as="geometry" />
        </mxCell>
        <mxCell id="id2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;Not sure? Holding pen&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;ambiguous matches are parked. They are never merged automatically and contribute nothing to any answer&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="330" x="570" y="437" as="geometry" />
        </mxCell>
        <mxCell id="id3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;A person decides&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;a human clears the holding pen, and who decided what, and when, is recorded&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="310" x="914" y="437" as="geometry" />
        </mxCell>
        <mxCell id="b4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;dashed=1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;" value="" vertex="1">
          <mxGeometry height="148" width="1030" x="210" y="532" as="geometry" />
        </mxCell>
        <mxCell id="b4n" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#CBD5E1;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="4" vertex="1">
          <mxGeometry height="30" width="60" x="130" y="536" as="geometry" />
        </mxCell>
        <mxCell id="b4l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2937;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="THE RECORD ITSELF" vertex="1">
          <mxGeometry height="16" width="400" x="226" y="542" as="geometry" />
        </mxCell>
        <mxCell id="b4d" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=2;fontColor=#64748B;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="Everything carries three times: when it happened · when the source wrote it down · when we received it. That is how a report arriving late cannot quietly rewrite what was known yesterday." vertex="1">
          <mxGeometry height="14" width="1000" x="226" y="558" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=12;fontColor=#1F2937;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;What happened&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;visits, diagnoses, drugs actually given, lab results, scans&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="247" x="226" y="584" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=12;fontColor=#1F2937;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;What the documents say&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;each fact tied to the exact page it came from&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="247" x="487" y="584" as="geometry" />
        </mxCell>
        <mxCell id="r3" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=7;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=12;fontColor=#1F2937;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;What money says&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;approvals, claims, queries, rejections&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="247" x="748" y="584" as="geometry" />
        </mxCell>
        <mxCell id="r4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;What is missing&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;here · waiting · never arrived · sources disagree · unreadable.&lt;br&gt;&lt;b&gt;&quot;Missing&quot; is never turned into &quot;no&quot;.&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="86" width="215" x="1009" y="584" as="geometry" />
        </mxCell>
