        <mxCell id="i3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;A photo or PDF someone uploads&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;the family&#39;s folder, a phone picture&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="247" x="748" y="150" as="geometry" />
        </mxCell>
        <mxCell id="i4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=12;fontColor=#1F2937;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;align=center;" value="&lt;b&gt;From the insurer and scheme portal&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;approvals, queries, rejections&lt;/font&gt;" vertex="1">
