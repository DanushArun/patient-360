        <mxCell id="sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748B;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="Read top to bottom: a record arrives, we check we are allowed to hold it, we work out whose it is, we store it, we check what is missing, then we answer questions about it." vertex="1">
