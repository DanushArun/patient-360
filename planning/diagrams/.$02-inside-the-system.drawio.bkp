        <mxCell id="b1l" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#1F2937;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="THE WAY IN" vertex="1">
          <mxGeometry height="16" width="400" x="226" y="110" as="geometry" />
        </mxCell>
        <mxCell id="b1d" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontStyle=2;fontColor=#64748B;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="Nothing is edited on the way in. The original file is kept with a fingerprint, so we can always prove what we received and when." vertex="1">
          <mxGeometry height="14" width="900" x="226" y="126" as="geometry" />
        </mxCell>
