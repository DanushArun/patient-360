          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="512" as="sourcePoint" />
            <mxPoint x="725" y="532" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a4" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94A3B8;endArrow=block;endFill=1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="676" as="sourcePoint" />
            <mxPoint x="725" y="696" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a5" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#94A3B8;endArrow=block;endFill=1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="820" as="sourcePoint" />
            <mxPoint x="725" y="840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a6" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B45309;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="964" as="sourcePoint" />
            <mxPoint x="725" y="984" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a7" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B45309;strokeWidth=2;endArrow=block;endFill=1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="725" y="1088" as="sourcePoint" />
            <mxPoint x="725" y="1108" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sp1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;" value="" vertex="1">
          <mxGeometry height="1152" width="200" x="1260" y="100" as="geometry" />
        </mxCell>
        <mxCell id="sp1t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=block;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#1F2937;spacingLeft=6;spacingRight=6;spacingTop=4;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;" value="&lt;b&gt;WHO CAN SEE WHAT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;i&gt;applies to every step above&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;Sign-in and role&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;coordinator · doctor · nurse · family · inspector. The family sees strictly less, and is refused medical questions.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;Hospitals kept apart&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;one hospital&#39;s patients can never appear inside another&#39;s, even by accident.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;Rules live in the database&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;not in the app, so no screen and no question can talk its way past them.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;Every look is recorded&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;who opened which record, when, and what they were shown.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;i&gt;This log is exactly what a hospital quality inspector asks to see.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="1120" width="172" x="1276" y="120" as="geometry" />
        </mxCell>
        <mxCell id="sp2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;" value="" vertex="1">
          <mxGeometry height="1152" width="200" x="1470" y="100" as="geometry" />
        </mxCell>
        <mxCell id="sp2t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=block;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#1F2937;spacingLeft=6;spacingRight=6;spacingTop=4;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;" value="&lt;b&gt;KEEPING IT RUNNING&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;i&gt;applies to every step above&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;Scheduled pickup&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;new records collected on a timetable, not when someone remembers.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;How fresh is this?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;every screen states how recent the information behind it is.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;Bad files are parked&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;an unreadable or broken file is set aside and reported — never silently dropped.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;Safe to run twice&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;re-sending the same file creates no duplicate record, fact or task.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;Spending limit&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;a ceiling per hospital, so cost cannot run away unnoticed.&lt;/font&gt;" vertex="1">
          <mxGeometry height="1120" width="172" x="1486" y="118" as="geometry" />
        </mxCell>
        <mxCell id="sp3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;" value="" vertex="1">
          <mxGeometry height="1152" width="200" x="1680" y="100" as="geometry" />
        </mxCell>
        <mxCell id="sp3t" parent="1" style="text;html=1;whiteSpace=wrap;overflow=block;strokeColor=none;fillColor=none;align=center;verticalAlign=top;fontSize=12;fontColor=#1F2937;spacingLeft=6;spacingRight=6;spacingTop=4;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;" value="&lt;b&gt;PROVING IT IS RIGHT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;i&gt;applies to every step above&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;A fixed set of test questions&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;with answers agreed in advance, so we can measure right and wrong.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;Questions held back&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;a second set nobody is allowed to tune against, opened only at the end.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;Does the page really say it?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;a person re-reads the quoted pages and confirms they support the sentence.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1F2937&quot;&gt;&lt;b&gt;Break-in attempts&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;deliberate attempts to pull another patient&#39;s data, or to hide instructions inside a document. All must fail.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B45309&quot;&gt;&lt;i&gt;Results are published with the system — including the failures.&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="1120" width="172" x="1696" y="116" as="geometry" />
        </mxCell>
        <mxCell id="leg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;" value="" vertex="1">
          <mxGeometry height="84" width="1840" x="40" y="1282" as="geometry" />
        </mxCell>
        <mxCell id="lg1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;" value="" vertex="1">
          <mxGeometry height="16" width="24" x="62" y="1302" as="geometry" />
        </mxCell>
        <mxCell id="lg1t" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748B;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="something stored" vertex="1">
          <mxGeometry height="16" width="200" x="94" y="1302" as="geometry" />
        </mxCell>
        <mxCell id="lg2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;" value="" vertex="1">
          <mxGeometry height="16" width="24" x="62" y="1328" as="geometry" />
        </mxCell>
        <mxCell id="lg2t" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748B;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="something that runs and produces a result" vertex="1">
          <mxGeometry height="16" width="300" x="94" y="1328" as="geometry" />
        </mxCell>
        <mxCell id="lg3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;fontSize=12;textShadow=0;align=center;" value="" vertex="1">
          <mxGeometry height="16" width="24" x="440" y="1302" as="geometry" />
        </mxCell>
        <mxCell id="lg3t" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#64748B;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="a stopping point — it can refuse, park something, or delete an unproven sentence" vertex="1">
          <mxGeometry height="16" width="500" x="472" y="1302" as="geometry" />
        </mxCell>
        <mxCell id="lg4t" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#B45309;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="Yellow bands (2 and 7) are the two places the system is allowed to say no: no permission, and no proof." vertex="1">
          <mxGeometry height="16" width="600" x="472" y="1328" as="geometry" />
        </mxCell>
        <mxCell id="lg5t" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#64748B;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="No real patient information is used anywhere. In the prototype, steps 1, 3 and the money side use invented data; the rulebooks are real public documents." vertex="1">
          <mxGeometry height="16" width="780" x="1080" y="1302" as="geometry" />
        </mxCell>
        <mxCell id="lg6t" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#64748B;rounded=0;labelBackgroundColor=none;labelBorderColor=none;fontFamily=Tahoma;textShadow=0;whiteSpace=wrap;" value="Nothing here decides anything medical. It reports what is present, what is missing, and where two sources disagree." vertex="1">
          <mxGeometry height="16" width="780" x="1080" y="1328" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
