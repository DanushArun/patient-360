    </mxCell>
    <mxCell id="b2" value="&lt;b&gt;Consent Manager&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;the patient's permission to fetch records — and to take it back&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
