    <mxCell id="cCt" value="WHO PAYS, AND WHETHER THEY AGREED" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="1196" y="462" width="380" height="18" as="geometry" />
    </mxCell>
    <mxCell id="cCn" value="in the prototype: stand-in data, not a live insurer" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontStyle=2;fontColor=#B45309;" vertex="1" parent="1">
      <mxGeometry x="1196" y="480" width="400" height="14" as="geometry" />
    </mxCell>
    <mxCell id="c1" value="&lt;b&gt;Government scheme portal (PM-JAY)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;approval that must exist before treatment starts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="1196" y="502" width="398" height="46" as="geometry" />
    </mxCell>
    <mxCell id="c2" value="&lt;b&gt;National Health Claims Exchange&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;the national rail that claims travel on&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="1196" y="556" width="398" height="46" as="geometry" />
    </mxCell>
    <mxCell id="c3" value="&lt;b&gt;Private insurer or TPA&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;approval letters, queries, rejections&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="1196" y="610" width="398" height="46" as="geometry" />
    </mxCell>
    <mxCell id="c4" value="&lt;b&gt;What the family pays themselves&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;the gap that sends families into debt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="1196" y="664" width="398" height="46" as="geometry" />
    </mxCell>

