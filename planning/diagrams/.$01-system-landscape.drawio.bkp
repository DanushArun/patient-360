    <mxCell id="cBn" value="in the prototype: shape copied, not connected" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontStyle=2;fontColor=#B45309;" vertex="1" parent="1">
