      <mxGeometry x="276" y="790" width="620" height="14" as="geometry" />
    </mxCell>
    <mxCell id="d1" value="&lt;b&gt;Government treatment and scheme rules&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;PM-JAY operations manual · National Cancer Grid treatment guidelines&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="276" y="812" width="628" height="44" as="geometry" />
    </mxCell>
    <mxCell id="d2" value="&lt;b&gt;Hospital quality standards&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;NABH — what a complete medical record must contain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="276" y="864" width="628" height="44" as="geometry" />
    </mxCell>
    <mxCell id="d3" value="&lt;b&gt;Privacy law and insurance rules&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Digital Personal Data Protection Act 2023 · IRDAI circulars on claim settlement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="276" y="916" width="628" height="44" as="geometry" />
    </mxCell>
    <mxCell id="d4" value="A question like &quot;what does the scheme require before this claim is sent?&quot; is answered from these — never invented." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#2F7D4F;" vertex="1" parent="1">
      <mxGeometry x="276" y="966" width="628" height="30" as="geometry" />
    </mxCell>

    <mxCell id="cE" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="950" y="760" width="660" height="250" as="geometry" />
    </mxCell>
    <mxCell id="cEt" value="THE FAMILY'S SIDE — HOW RECORDS ACTUALLY MOVE TODAY" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="966" y="772" width="560" height="18" as="geometry" />
    </mxCell>
    <mxCell id="cEn" value="the message before travelling is built in the prototype" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontStyle=2;fontColor=#B45309;" vertex="1" parent="1">
      <mxGeometry x="966" y="790" width="560" height="14" as="geometry" />
    </mxCell>
    <mxCell id="e1" value="&lt;b&gt;Photographs of paper reports on a phone&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;the most common way a record reaches the next hospital&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="966" y="812" width="628" height="44" as="geometry" />
    </mxCell>
    <mxCell id="e2" value="&lt;b&gt;A folder of printed reports carried on the train&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;the family is the courier, and the backup copy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="966" y="864" width="628" height="44" as="geometry" />
    </mxCell>
    <mxCell id="e3" value="&lt;b&gt;The report that never arrived&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;this is the thing the whole system exists to catch, before the journey&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;strokeWidth=2;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="966" y="916" width="628" height="44" as="geometry" />
    </mxCell>
    <mxCell id="e4" value="&lt;b&gt;Message to the family before they travel&lt;/b&gt; — exactly what to bring. Checked by a person first; it is a list of documents, never medical advice." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=9;fontStyle=2;fontColor=#B45309;" vertex="1" parent="1">
      <mxGeometry x="966" y="966" width="628" height="30" as="geometry" />
    </mxCell>

