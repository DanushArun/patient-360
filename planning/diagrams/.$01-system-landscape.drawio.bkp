    <mxCell id="title" value="What this system touches — the whole picture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="40" y="22" width="1100" height="30" as="geometry" />
    </mxCell>
    <mxCell id="sub" value="Every person who uses it, and every system it reads from or writes to, in a real Indian hospital." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748B;" vertex="1" parent="1">
      <mxGeometry x="40" y="50" width="1100" height="20" as="geometry" />
    </mxCell>
    <mxCell id="subkey" value="Solid outline = built in the 18-day prototype.&#160;&#160;&#160;Dotted outline = real-world connection, designed but not built yet." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#B45309;" vertex="1" parent="1">
      <mxGeometry x="40" y="70" width="1100" height="18" as="geometry" />
    </mxCell>

    <mxCell id="plab" value="PEOPLE WHO USE IT" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#64748B;" vertex="1" parent="1">
      <mxGeometry x="56" y="120" width="180" height="18" as="geometry" />
    </mxCell>

    <mxCell id="p1" value="&lt;b&gt;Care coordinator&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;chases missing reports&lt;br&gt;and approvals&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="260" y="112" width="210" height="72" as="geometry" />
    </mxCell>
    <mxCell id="p2" value="&lt;b&gt;Treating doctor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;reads the record in the&lt;br&gt;2 minutes before the visit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="488" y="112" width="210" height="72" as="geometry" />
    </mxCell>
    <mxCell id="p3" value="&lt;b&gt;Day-care nurse&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;checks the patient is safe&lt;br&gt;to start today&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="716" y="112" width="210" height="72" as="geometry" />
    </mxCell>
    <mxCell id="p4" value="&lt;b&gt;Insurance desk&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;gets approval before&lt;br&gt;the family is billed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="944" y="112" width="210" height="72" as="geometry" />
    </mxCell>
    <mxCell id="p5" value="&lt;b&gt;Patient and family&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;travelling from another&lt;br&gt;city, carrying the file&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="1172" y="112" width="210" height="72" as="geometry" />
    </mxCell>
    <mxCell id="p6" value="&lt;b&gt;Hospital quality team&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;proves records are complete&lt;br&gt;at NABH inspection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="1400" y="112" width="210" height="72" as="geometry" />
    </mxCell>

    <mxCell id="sys" value="&lt;font style=&quot;font-size: 15px;&quot;&gt;&lt;b&gt;Care Readiness &amp;amp; Evidence Copilot&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Answers one question, with the proof attached:&lt;br&gt;&lt;b&gt;is this patient ready for their next treatment — medically, on paper, and on money — and exactly what is missing?&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size: 11px;&quot;&gt;Four screens:&#160;&#160;today's review list&#160;&#160;·&#160;&#160;one patient's full picture&#160;&#160;·&#160;&#160;ask a question&#160;&#160;·&#160;&#160;chase and close gaps&lt;br&gt;Every sentence it shows opens the exact document page or record row behind it. It never gives medical advice.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F2937;strokeWidth=3;fontSize=12;fontColor=#1F2937;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="260" y="224" width="1350" height="170" as="geometry" />
    </mxCell>

    <mxCell id="cA" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="260" y="450" width="430" height="272" as="geometry" />
    </mxCell>
    <mxCell id="cAt" value="INSIDE THE HOSPITAL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="276" y="462" width="300" height="18" as="geometry" />
    </mxCell>
