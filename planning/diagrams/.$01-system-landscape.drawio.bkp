      <mxGeometry x="276" y="480" width="400" height="14" as="geometry" />
    </mxCell>
    <mxCell id="a1" value="&lt;b&gt;Hospital record system&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;visits, diagnosis, treatment plan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="276" y="502" width="398" height="46" as="geometry" />
