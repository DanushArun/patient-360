    <mxCell id="eB" value="asks permission,&#10;then fetches" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;endArrow=block;endFill=1;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="cB">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="eC" value="checks approval&#10;is really in place" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748B;endArrow=block;endFill=1;fontSize=10;fontColor=#64748B;labelBackgroundColor=#FFFFFF;exitX=0.84;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="cC">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="eD" value="quotes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2F7D4F;endArrow=block;endFill=1;fontSize=10;fontColor=#2F7D4F;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="sys" target="cD">
      <mxGeometry relative="1" x="-0.6" as="geometry">
        <Array as="points">
