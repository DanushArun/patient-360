    </mxCell>
    <mxCell id="b3" value="&lt;b&gt;Other hospitals and labs&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;records from the town the patient travelled from&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="736" y="610" width="398" height="46" as="geometry" />
    </mxCell>
    <mxCell id="b4" value="&lt;b&gt;Hospital and doctor registries&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;proves the hospital and clinician are who they claim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
