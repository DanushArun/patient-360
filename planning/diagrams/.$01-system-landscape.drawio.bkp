    <mxCell id="cBt" value="INDIA'S NATIONAL HEALTH NETWORK" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="736" y="462" width="360" height="18" as="geometry" />
