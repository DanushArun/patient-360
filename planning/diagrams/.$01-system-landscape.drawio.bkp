    <mxCell id="a3" value="&lt;b&gt;Scan and imaging reports&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;CT, MRI, heart scan before certain drugs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
      <mxGeometry x="276" y="610" width="398" height="46" as="geometry" />
    </mxCell>
    <mxCell id="a4" value="&lt;b&gt;Chemotherapy day-care schedule&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;who is booked for which chair, which day&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;dashed=1;dashPattern=6 4;fontSize=10;fontColor=#1F2937;" vertex="1" parent="1">
